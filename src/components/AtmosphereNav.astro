---
import CalculatorNav from './CalculatorNav.astro';

interface Props {
	active: 'calculator' | 'graph' | 'table' | 'notes';
}
const { active } = Astro.props;

const tabs = [
	{ id: 'calculator', label: 'Calculator', href: '/online-tools/atmosphere' },
	{ id: 'graph',      label: 'Graph',      href: '/online-tools/atmosphere/graph' },
	{ id: 'table',      label: 'Table',      href: '/online-tools/atmosphere/table' },
	{ id: 'notes',      label: 'Notes',      href: '/online-tools/atmosphere/notes' },
];
---

<CalculatorNav tabs={tabs} active={active} />
