---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AtmosphereNav from '../../../components/AtmosphereNav.astro';
---

<Layout title="Table | Standard Atmosphere Calculator">
	<Breadcrumb crumbs={[
		{ label: 'Home', href: '/' },
		{ label: 'Calculators', href: '/calculators' },
		{ label: 'Standard Atmosphere Calculator' },
	]} />
	<h1>Standard Atmosphere Calculator</h1>
	<AtmosphereNav active="table" />
	<p>Tabulate atmospheric properties as a function of altitude using a version of 
		the <a href="https://en.wikipedia.org/wiki/U.S._Standard_Atmosphere" target="_blank">U.S. Standard Atmosphere 1976 model</a>.</p>

	<section class="table-page">
		<div class="controls">
			<h2>Settings</h2>

			<h3>Conditions</h3>
			<div class="field">
				<label for="cond-alt">Altitude</label>
				<div class="input-row">
					<input type="number" id="cond-alt" value="0" />
					<select id="cond-alt-unit">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-cond-alt"></p>
			<div class="field">
				<label for="sl-temp" id="lbl-sl-temp">Sea-level temperature</label>
				<div class="input-row">
					<input type="number" id="sl-temp" value="15" />
					<select id="sl-temp-unit">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-sl-temp"></p>
			<div class="field">
				<label for="sl-pressure" id="lbl-sl-pressure">Sea-level pressure</label>
				<div class="input-row">
					<input type="number" id="sl-pressure" value="1" />
					<select id="sl-pressure-unit">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-sl-pressure"></p>
			<div class="reset-row">
				<button id="btn-reset">Reset to standard conditions</button>
			</div>

			<h3>Input settings</h3>
			<div class="field">
				<label for="x-var">Altitude</label>
				<select id="x-var">
					<option value="geometric" selected>Geometric</option>
					<option value="geopotential">Geopotential</option>
				</select>
			</div>
			<div class="field">
				<label for="temp-mode">Temperature</label>
				<select id="temp-mode">
					<option value="sea-level" selected>Sea-level temperature</option>
					<option value="air">Air temperature</option>
				</select>
			</div>
			<div class="field">
				<label for="pressure-mode">Pressure</label>
				<select id="pressure-mode">
					<option value="sea-level" selected>Sea-level pressure</option>
					<option value="air">Air pressure</option>
					<option value="altimeter">Altimeter setting</option>
				</select>
			</div>

			<h3>Altitude</h3>
			<div class="field">
				<label>Range</label>
				<div class="range-row">
					<input type="number" id="x-min" value="0" />
					<span>–</span>
					<input type="number" id="x-max" value="10000" />
					<select id="x-unit">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-x-range"></p>
			<div class="field">
				<label for="x-intervals">Rows</label>
				<input type="number" id="x-intervals" value="10" min="1" step="1" />
			</div>
			<p class="error" id="err-x-intervals"></p>

			<h3>Dependent variables</h3>
			<div class="var-list" id="var-list">
				<div class="var-row">
					<input type="checkbox" id="chk-pressure" data-var="pressure" checked />
					<label for="chk-pressure">Air pressure</label>
					<select id="unit-pressure">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-altimeter_setting" data-var="altimeter_setting" />
					<label for="chk-altimeter_setting">Altimeter setting</label>
					<select id="unit-altimeter_setting">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-sea_level_pressure" data-var="sea_level_pressure" />
					<label for="chk-sea_level_pressure">Sea-level pressure</label>
					<select id="unit-sea_level_pressure">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-temperature" data-var="temperature" checked />
					<label for="chk-temperature">Air temperature</label>
					<select id="unit-temperature">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-density" data-var="density" />
					<label for="chk-density">Air density</label>
					<select id="unit-density">
						<option value="kg/m3" selected>kg/m³</option>
						<option value="lb/ft3">lb/ft³</option>
						<option value="slug/ft3">slug/ft³</option>
						<option value="sigma">sigma (SL std=1)</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-pressure_altitude" data-var="pressure_altitude" />
					<label for="chk-pressure_altitude">Pressure altitude</label>
					<select id="unit-pressure_altitude">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-density_altitude" data-var="density_altitude" />
					<label for="chk-density_altitude">Density altitude</label>
					<select id="unit-density_altitude">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-gravity" data-var="gravity" />
					<label for="chk-gravity">Gravitational acceleration</label>
					<select id="unit-gravity">
						<option value="m/s2" selected>m/s²</option>
						<option value="ft/s2">ft/s²</option>
						<option value="g0">g (SL std=1)</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-geopotential_alt" data-var="geopotential_alt" />
					<label for="chk-geopotential_alt">Geopotential altitude</label>
					<select id="unit-geopotential_alt">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-geometric_alt" data-var="geometric_alt" />
					<label for="chk-geometric_alt">Geometric altitude</label>
					<select id="unit-geometric_alt">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-molar_mass" data-var="molar_mass" />
					<label for="chk-molar_mass">Molar mass</label>
					<select id="unit-molar_mass">
						<option value="g/mol" selected>g/mol</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-speed_of_sound" data-var="speed_of_sound" />
					<label for="chk-speed_of_sound">Speed of sound</label>
					<select id="unit-speed_of_sound">
						<option value="m/s" selected>m/s</option>
						<option value="km/h">km/h</option>
						<option value="mph">mph</option>
						<option value="ft/s">ft/s</option>
						<option value="kn">knots</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-viscosity" data-var="viscosity" />
					<label for="chk-viscosity">Dynamic viscosity</label>
					<select id="unit-viscosity">
						<option value="Pa·s" selected>Pa·s</option>
						<option value="mPa·s">mPa·s (cP)</option>
						<option value="μPa·s">μPa·s</option>
						<option value="lbf·s/ft2">lbf·s/ft²</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-mean_free_path" data-var="mean_free_path" />
					<label for="chk-mean_free_path">Mean free path</label>
					<select id="unit-mean_free_path">
						<option value="nm">nm</option>
						<option value="μm">μm</option>
						<option value="mm">mm</option>
						<option value="m" selected>m</option>
						<option value="km">km</option>
						<option value="in">in</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
					</select>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-scale_height" data-var="scale_height" />
					<label for="chk-scale_height">Scale height</label>
					<select id="unit-scale_height">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-row pp-header">
					<span class="pp-label">Number density</span>
					<select id="unit-molecular_density">
						<option value="per_m3" selected>/m³</option>
						<option value="per_L">/L</option>
						<option value="per_ft3">/ft³</option>
						<option value="mol_m3">mol/m³</option>
						<option value="kmol_m3">kmol/m³ (mol/L)</option>
						<option value="lbmol_ft3">lbmol/ft³</option>
					</select>
				</div>
				<div class="pp-species">
					<label><input type="checkbox" data-var="molecular_density" data-species="total"> Total</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N2"> N₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="O2"> O₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Ar"> Ar</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="CO2"> CO₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Ne"> Ne</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="He"> He</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="CH4"> CH₄</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Kr"> Kr</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="H2"> H₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N2O"> N₂O</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Xe"> Xe</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="O"> O</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="H"> H</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N"> N</label>
				</div>
				<div class="var-row pp-header">
					<span class="pp-label">Mole fraction</span>
				</div>
				<div class="pp-species">
					<label><input type="checkbox" data-var="mole_fraction" data-species="total"> Total</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N2"> N₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="O2"> O₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Ar"> Ar</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="CO2"> CO₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Ne"> Ne</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="He"> He</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="CH4"> CH₄</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Kr"> Kr</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="H2"> H₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N2O"> N₂O</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Xe"> Xe</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="O"> O</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="H"> H</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N"> N</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-boiling_point" data-var="boiling_point" />
					<label for="chk-boiling_point">Boiling point of water</label>
					<select id="unit-boiling_point">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
			</div>
			<div class="checkbox-row">
				<input type="checkbox" id="sci-notation" />
				<label for="sci-notation">Use scientific notation</label>
			</div>
		</div>

		<div class="table-area">
			<div class="table-wrapper">
				<table id="atm-table">
					<thead><tr id="table-head"></tr></thead>
					<tbody id="table-body"></tbody>
				</table>
			</div>
			<div class="table-actions">
				<button id="btn-export-csv">Export CSV</button>
			</div>
		</div>
	</section>
</Layout>

<style>
	.table-page {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1.5rem;
		align-items: start;
	}

	.error {
		color: red;
		font-size: 0.875rem;
		margin: 0 0 0.4rem;
	}

	.field {
		display: grid;
		grid-template-columns: 6rem 1fr;
		align-items: center;
		column-gap: 0.5rem;
		margin-bottom: 0.4rem;
	}

	input[type="number"] {
		flex: 1;
		min-width: 0;
		max-width: 6rem;
	}

	select {
		width: 100%;
	}

	.input-row select,
	.range-row select {
		width: auto;
	}

	.range-row input[type="number"] {
		max-width: 4rem;
	}

	.checkbox-row {
		margin-bottom: 0.4rem;
	}

	.var-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-height: 24rem;
		overflow-y: auto;
		border: 1px solid var(--color-border);
		border-radius: 0;
		padding: 0.4rem 0.5rem;
		margin-bottom: 0.5rem;
	}

	.var-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.var-row input[type="checkbox"] {
		flex-shrink: 0;
	}

	.var-row label {
		flex: 1;
		min-width: 0;
		font-size: 0.9375rem;
	}

	.var-row select {
		width: auto;
		flex-shrink: 0;
		font-size: 0.9375rem;
		padding: 0.15rem 0.25rem;
	}

	.pp-header .pp-label {
		flex: 1;
		font-size: 0.9375rem;
	}

	.pp-species {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: 0.1rem 0.6rem;
		padding: 0.1rem 0 0.2rem 1.25rem;
		font-size: 0.9375rem;
	}

	.pp-species label {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		cursor: pointer;
	}

	.table-area {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.table-wrapper {
		overflow-x: auto;
	}

	.table-actions button {
		font-size: 1rem;
	}

	@media (max-width: 700px) {
		.table-page {
			grid-template-columns: 1fr;
		}
	}
</style>

<style is:global>
	#atm-table {
		border-collapse: collapse;
		width: auto;
		font-size: 1rem;
		border: 1px solid var(--color-text);
	}

	#atm-table th,
	#atm-table td {
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--color-text);
		text-align: center;
		vertical-align: middle;
		white-space: nowrap;
	}

	#atm-table th {
		background: var(--color-output-bg);
		font-weight: bold;
		color: var(--color-heading);
	}

	#atm-table td {
		color: var(--color-text);
	}

	#atm-table tr:nth-child(even) td {
		background: var(--color-output-bg);
	}
</style>

<script>
	import * as atm from '../../../lib/atmosphere.ts';
	import { getBoilingPoint } from '../../../lib/water-properties.ts';
	import { convert } from '../../../lib/convert.ts';
	import { roundSig } from '../../../lib/helpers.ts';

	// Geopotential-altitude equivalents of the model's geometric range (-5000 to 1000000 m),
	// computed rather than hardcoded so bound-check messages round to the true value.
	const GEOPOT_MIN = atm.geometricToGeopotential(-5000);
	const GEOPOT_MAX = atm.geometricToGeopotential(1000000);

	// At or above atm.AIR_TEMP_MAX_GEOPOT, sea-level temp has no effect on air temp at all,
	// so back-solving sea-level temp from an entered air temp is meaningless there —
	// disable the "Air temperature" option and fall back to "Sea-level temperature" mode
	// if it was selected.
	function syncTempModeAvailability() {
		const tempModeSel = document.getElementById('temp-mode') as HTMLSelectElement;
		const airOption   = tempModeSel.querySelector('option[value="air"]') as HTMLOptionElement;
		const condAltVal  = parseFloat((document.getElementById('cond-alt') as HTMLInputElement).value);
		const condAltUnit = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const xVar        = (document.getElementById('x-var') as HTMLSelectElement).value;

		if (isNaN(condAltVal)) {
			airOption.disabled = false;
			return;
		}
		const condAlt_m = convert(condAltVal, condAltUnit, 'm');
		const H_cond = xVar === 'geopotential' ? condAlt_m : atm.geometricToGeopotential(condAlt_m);
		const aboveLimit = H_cond >= atm.AIR_TEMP_MAX_GEOPOT;
		airOption.disabled = aboveLimit;
		if (aboveLimit && tempModeSel.value === 'air') {
			tempModeSel.value = 'sea-level';
			updateConditionLabels();
		}
	}

	const SPECIES_DISPLAY: Record<string, string> = {
		total: 'Total',
		N2: 'N₂', O2: 'O₂', Ar: 'Ar', CO2: 'CO₂',
		Ne: 'Ne', He: 'He', CH4: 'CH₄', Kr: 'Kr', H2: 'H₂', N2O: 'N₂O', Xe: 'Xe',
		O: 'O', H: 'H', N: 'N',
	};

	const Y_LABELS: Record<string, string> = {
		pressure:          'Air pressure',
		altimeter_setting: 'Altimeter setting',
		sea_level_pressure:'Sea-level pressure',
		temperature:       'Air temperature',
		density:           'Air density',
		pressure_altitude: 'Pressure altitude',
		density_altitude:  'Density altitude',
		speed_of_sound:    'Speed of sound',
		scale_height:      'Scale height',
		viscosity:         'Dynamic viscosity',
		gravity:           'Gravitational acceleration',
		geopotential_alt:  'Geopotential altitude',
		geometric_alt:     'Geometric altitude',
		molecular_density: 'Number density',
		mole_fraction:     'Mole fraction',
		molar_mass:        'Molar mass',
		mean_free_path:    'Mean free path',
		boiling_point:     'Boiling point of water',
	};

	interface VarConfig {
		key: string;
		unit: string;
		species: string;
		label: string;
	}

	function getCheckedVars(): VarConfig[] {
		return Array.from(
			document.querySelectorAll<HTMLInputElement>('#var-list input[type=checkbox]:checked')
		).map(chk => {
			const key = chk.dataset.var!;
			const unitSel = document.getElementById(`unit-${key}`) as HTMLSelectElement | null;
			const unit = unitSel?.value ?? '';
			const unitLabel = unitSel ? unitSel.options[unitSel.selectedIndex].text : '';
			const species = chk.dataset.species ?? '';
			const label = key === 'mole_fraction'
				? `Mole fraction ${SPECIES_DISPLAY[species]}`
				: key === 'molecular_density'
				? `Number density (${unitLabel}) ${SPECIES_DISPLAY[species]}`
				: `${Y_LABELS[key]} (${unitLabel})`;
			return { key, unit, species, label };
		});
	}

	function fmtY(v: number, key: string, unit: string): string {
		const sci = (document.getElementById('sci-notation') as HTMLInputElement).checked;
		if (sci) return v.toExponential(5);
		if (key === 'temperature' || key === 'boiling_point') return roundSig(v, 6, 1e-4, false, unit);
		return roundSig(v, 6);
	}

	let tableData: { x: number; ys: (number | null)[] }[] = [];
	let tableXLabel = '';
	let tableYConfigs: VarConfig[] = [];

	function generateTable() {
		syncTempModeAvailability();

		const condAltVal  = parseFloat((document.getElementById('cond-alt') as HTMLInputElement).value);
		const condAltUnit = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const slTempVal   = parseFloat((document.getElementById('sl-temp') as HTMLInputElement).value);
		const slTempUnit  = (document.getElementById('sl-temp-unit') as HTMLSelectElement).value;
		const slPressVal  = parseFloat((document.getElementById('sl-pressure') as HTMLInputElement).value);
		const slPressUnit = (document.getElementById('sl-pressure-unit') as HTMLSelectElement).value;
		const xVar        = (document.getElementById('x-var') as HTMLSelectElement).value;
		const tempMode    = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		const pressMode   = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		const xUnit       = (document.getElementById('x-unit') as HTMLSelectElement).value;
		const xMin        = parseFloat((document.getElementById('x-min') as HTMLInputElement).value);
		const xMax        = parseFloat((document.getElementById('x-max') as HTMLInputElement).value);
		const N_raw       = parseInt((document.getElementById('x-intervals') as HTMLInputElement).value);
		const N           = isNaN(N_raw) ? 10 : N_raw;

		const vars = getCheckedVars();

		const errCondAlt    = document.getElementById('err-cond-alt') as HTMLElement;
		const errSlTemp     = document.getElementById('err-sl-temp') as HTMLElement;
		const errSlPressure = document.getElementById('err-sl-pressure') as HTMLElement;
		const errXRange     = document.getElementById('err-x-range') as HTMLElement;
		const errXIntervals = document.getElementById('err-x-intervals') as HTMLElement;
		errCondAlt.textContent = '';
		errSlTemp.textContent = '';
		errSlPressure.textContent = '';
		errXRange.textContent = '';
		errXIntervals.textContent = '';

		const thead = document.getElementById('table-head') as HTMLElement;
		const tbody = document.getElementById('table-body') as HTMLElement;

		if (N < 1 || N > 1000) {
			errXIntervals.textContent = 'Number of rows must be between 1 and 1000.';
			thead.innerHTML = ''; tbody.innerHTML = '';
			return;
		}

		if ([condAltVal, slTempVal, slPressVal, xMin, xMax].some(isNaN) || xMin >= xMax || vars.length === 0) {
			thead.innerHTML = '';
			tbody.innerHTML = '';
			return;
		}

		// Conditions altitude → geopotential
		const condAlt_m = convert(condAltVal, condAltUnit, 'm');
		const H_cond = xVar === 'geopotential' ? condAlt_m : atm.geometricToGeopotential(condAlt_m);
		const loH = xVar === 'geopotential' ? GEOPOT_MIN : -5000;
		const hiH = xVar === 'geopotential' ? GEOPOT_MAX : 1000000;
		if (condAlt_m < loH || condAlt_m > hiH) {
			const factor = convert(1, 'm', condAltUnit);
			errCondAlt.textContent = `Altitude must be between ${roundSig(loH * factor, 6, 1e-6, true)} and ${roundSig(hiH * factor, 6, 1e-6, true)} ${condAltUnit}.`;
			thead.innerHTML = ''; tbody.innerHTML = '';
			return;
		}

		// Derive T0_K
		const T_input_K = convert(slTempVal, slTempUnit, 'K');
		const z_cond = xVar === 'geopotential' ? atm.geopotentialToGeometric(condAlt_m) : condAlt_m;
		const T0_K = tempMode === 'air' ? atm.getSeaLevelTemperature(z_cond, T_input_K) : T_input_K;
		const loK = atm.SEA_LEVEL_TEMP_MIN_K, hiK = atm.SEA_LEVEL_TEMP_MAX_K;
		if (isNaN(T0_K) || T0_K < loK || T0_K > hiK) {
			const unitLabel: Record<string, string> = { C: '°C', F: '°F', K: 'K', R: '°R' };
			if (tempMode === 'air') {
				const fmtT = (K: number) => parseFloat(convert(K, 'K', slTempUnit).toFixed(3)).toString();
				const xK = atm.getTemperature(z_cond, hiK);
				errSlTemp.textContent = `Temperature at this altitude must be between ${fmtT(loK)} and ${fmtT(xK)} ${unitLabel[slTempUnit]}.`;
			} else {
				const fmt = (K: number) => roundSig(convert(K, 'K', slTempUnit), 6, 1e-6, true);
				errSlTemp.textContent = `Sea-level temperature must be between ${fmt(loK)} and ${fmt(hiK)} ${unitLabel[slTempUnit]}.`;
			}
			thead.innerHTML = ''; tbody.innerHTML = '';
			return;
		}

		// Derive P0_Pa
		const P_input_Pa = convert(slPressVal, slPressUnit, 'Pa');
		let P0_Pa: number;
		if (pressMode === 'sea-level') {
			P0_Pa = P_input_Pa;
		} else if (pressMode === 'air') {
			P0_Pa = atm.getSeaLevelPressure(z_cond, P_input_Pa, T0_K);
		} else {
			const P_at_cond = P_input_Pa * atm.getPressure(z_cond, 1, 288.15);
			P0_Pa = atm.getSeaLevelPressure(z_cond, P_at_cond, T0_K);
		}
		if (P_input_Pa <= 0) {
			const label = pressMode === 'air' ? 'Air pressure' : pressMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
			errSlPressure.textContent = `${label} must be greater than 0 ${slPressUnit}.`;
			thead.innerHTML = ''; tbody.innerHTML = '';
			return;
		}

		const xMin_m = convert(xMin, xUnit, 'm');
		const xMax_m = convert(xMax, xUnit, 'm');
		const loX = xVar === 'geopotential' ? GEOPOT_MIN : -5000;
		const hiX = xVar === 'geopotential' ? GEOPOT_MAX : 1000000;
		if (xMin_m < loX || xMax_m > hiX) {
			const factor = convert(1, 'm', xUnit);
			const lo = roundSig(loX * factor, 6, 1e-6, true);
			const hi = roundSig(hiX * factor, 6, 1e-6, true);
			errXRange.textContent = `Altitude range must be between ${lo} and ${hi} ${xUnit}.`;
			thead.innerHTML = ''; tbody.innerHTML = '';
			return;
		}

		const xLabel = `${xVar === 'geometric' ? 'Geometric' : 'Geopotential'} altitude (${xUnit})`;
		tableXLabel = xLabel;
		tableYConfigs = vars;

		tableData = [];
		for (let i = 0; i <= N; i++) {
			const frac = i / N;
			const xVal = xMin + (xMax - xMin) * frac;
			const x_m  = xMin_m + (xMax_m - xMin_m) * frac;

			const h_m = xVar === 'geometric' ? x_m : atm.geopotentialToGeometric(x_m);
			const H   = atm.geometricToGeopotential(h_m);

			if (h_m < -5000) { tableData.push({ x: xVal, ys: vars.map(() => null) }); continue; }

			const P_Pa = atm.getPressure(h_m, P0_Pa, T0_K);
			const T_K  = atm.getTemperature(h_m, T0_K);
			const rho  = atm.getDensity(P_Pa, T_K, h_m);

			const ys = vars.map(v => {
				switch (v.key) {
					case 'pressure':           return convert(P_Pa, 'Pa', v.unit);
					case 'altimeter_setting':  return convert(atm.getAltimeterSetting(h_m, P_Pa), 'Pa', v.unit);
					case 'sea_level_pressure': return convert(atm.getSeaLevelPressure(h_m, P_Pa, T0_K), 'Pa', v.unit);
					case 'temperature':        return convert(T_K, 'K', v.unit);
					case 'density':            return convert(rho, 'kg/m3', v.unit);
					case 'pressure_altitude': {
						const pa = atm.getPressureAltitude(P_Pa);
						return isNaN(pa) ? null : convert(pa, 'm', v.unit);
					}
					case 'density_altitude': {
						const da = atm.getDensityAltitude(rho);
						return isNaN(da) ? null : convert(da, 'm', v.unit);
					}
					case 'speed_of_sound':     return convert(atm.getSpeedOfSound(T_K, atm.getMolarMass(h_m)), 'm/s', v.unit);
					case 'scale_height':       return convert(atm.getScaleHeight(T_K, atm.getMolarMass(h_m), h_m), 'm', v.unit);
					case 'viscosity':          return convert(atm.getViscosity(T_K), 'Pa·s', v.unit);
					case 'gravity':            return convert(atm.getGravity(h_m), 'm/s2', v.unit);
					case 'geopotential_alt':   return convert(H, 'm', v.unit);
					case 'geometric_alt':      return convert(h_m, 'm', v.unit);
					case 'molecular_density': {
						const n_total = atm.getNumberDensity(P_Pa, T_K);
						const mf = v.species === 'total' ? 1 : (atm.getMoleFraction(v.species, h_m) ?? 0);
						return convert(mf * n_total, 'per_m3', v.unit);
					}
					case 'mole_fraction':
						return v.species === 'total' ? 1 : (atm.getMoleFraction(v.species, h_m) ?? 0);
					case 'molar_mass':         return atm.getMolarMass(h_m);
					case 'mean_free_path':     return convert(atm.getMeanFreePath(P_Pa, T_K), 'm', v.unit);
					case 'boiling_point': {
						const bp = getBoilingPoint(P_Pa);
						return bp >= 273.16 ? convert(bp, 'K', v.unit) : null;
					}
					default: return null;
				}
			});
			tableData.push({ x: xVal, ys });
		}

		// Render
		thead.innerHTML = `<th>${xLabel}</th>` + vars.map(v => `<th>${v.label}</th>`).join('');
		tbody.innerHTML = tableData.map(row =>
			`<tr><td>${roundSig(row.x, 6, 1e-4, true)}</td>${row.ys.map((y, i) =>
				`<td>${y !== null ? fmtY(y, vars[i].key, vars[i].unit) : 'N/A'}</td>`
			).join('')}</tr>`
		).join('');
	}

	function updateConditionLabels() {
		const tMode = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		(document.getElementById('lbl-sl-temp') as HTMLElement).textContent =
			tMode === 'air' ? 'Air temperature' : 'Sea-level temperature';
		const pMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		(document.getElementById('lbl-sl-pressure') as HTMLElement).textContent =
			pMode === 'air' ? 'Air pressure' : pMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
	}

	// Initial render
	generateTable();
	updateConditionLabels();

	document.getElementById('temp-mode')!.addEventListener('change', () => { updateConditionLabels(); generateTable(); });
	document.getElementById('pressure-mode')!.addEventListener('change', () => { updateConditionLabels(); generateTable(); });
	document.getElementById('x-unit')!.addEventListener('change', generateTable);
	document.getElementById('sci-notation')!.addEventListener('change', generateTable);

	for (const id of ['cond-alt', 'cond-alt-unit', 'sl-temp', 'sl-temp-unit', 'sl-pressure', 'sl-pressure-unit',
		'x-var', 'x-min', 'x-max', 'x-intervals']) {
		const el = document.getElementById(id)!;
		el.addEventListener('input', generateTable);
		el.addEventListener('change', generateTable);
	}

	// Single delegated listener for all var-list checkboxes and selects
	document.getElementById('var-list')!.addEventListener('change', generateTable);

	// Reset to standard conditions
	document.getElementById('btn-reset')!.addEventListener('click', () => {
		const altUnit   = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const tempUnit  = (document.getElementById('sl-temp-unit') as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sl-pressure-unit') as HTMLSelectElement).value;
		(document.getElementById('cond-alt') as HTMLInputElement).value =
			roundSig(convert(0, 'm', altUnit), 6, 1e-6, true);
		(document.getElementById('sl-temp') as HTMLInputElement).value =
			roundSig(convert(288.15, 'K', tempUnit), 6, 1e-6, true);
		(document.getElementById('sl-pressure') as HTMLInputElement).value =
			roundSig(convert(101325, 'Pa', pressUnit), 6, 1e-6, true);
		(document.getElementById('temp-mode') as HTMLSelectElement).value = 'sea-level';
		(document.getElementById('pressure-mode') as HTMLSelectElement).value = 'sea-level';
		updateConditionLabels();
		generateTable();
	});

	// Export CSV
	document.getElementById('btn-export-csv')!.addEventListener('click', () => {
		if (tableData.length === 0 || tableYConfigs.length === 0) return;
		let csv = `"${tableXLabel}",${tableYConfigs.map(v => `"${v.label}"`).join(',')}\n`;
		for (const row of tableData) {
			csv += `${roundSig(row.x, 6, 1e-4, true)},${row.ys.map((y, i) =>
				y !== null ? fmtY(y, tableYConfigs[i].key, tableYConfigs[i].unit) : 'N/A'
			).join(',')}\n`;
		}
		const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
		const a = Object.assign(document.createElement('a'), { href: url, download: 'atmosphere-table.csv' });
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});
</script>
