---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AtmosphereNav from '../../../components/AtmosphereNav.astro';
---

<Layout>
	<Breadcrumb crumbs={[
			{ label: 'Home', href: '/' },
			{ label: 'Calculators', href: '/calculators' },
			{ label: 'U.S. Standard Atmosphere Calculator' },
		]} />
		<h1>U.S. Standard Atmosphere Calculator</h1>
		<p>Calculates atmospheric properties at a given altitude using the <a href="https://en.wikipedia.org/wiki/U.S._Standard_Atmosphere" target="_blank">U.S. Standard Atmosphere 1976 model</a>, with adjustable sea-level conditions.</p>
		<AtmosphereNav active="calculator" />

		<section class="calculator">
			<div class="inputs">
				<h2>Inputs</h2>

				<div class="field">
					<label for="altitude">Altitude</label>
					<div class="input-row">
						<input type="number" id="altitude" value="0" />
						<select id="altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
					<p class="error" id="err-altitude"></p>
				</div>

				<div class="field">
					<label for="sea-level-temp" id="lbl-temp-input">Sea-level temperature</label>
					<div class="input-row">
						<input type="number" id="sea-level-temp" value="15" />
						<select id="sea-level-temp-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
					<p class="error" id="err-temp"></p>
				</div>

				<div class="field">
					<label for="sea-level-pressure" id="lbl-pressure-input">Sea-level pressure</label>
					<div class="input-row">
						<input type="number" id="sea-level-pressure" value="1" />
						<select id="sea-level-pressure-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
					<p class="error" id="err-pressure"></p>
				</div>

				<p id="std-conditions-note" style="font-style:italic;"></p>

				<div class="unit-buttons">
					<button id="btn-reset">Reset to standard conditions</button>
				</div>

				<h3>Settings</h3>
				<div class="field">
					<label for="altitude-mode">Altitude input</label>
					<select id="altitude-mode">
						<option value="geometric" selected>Geometric</option>
						<option value="geopotential">Geopotential</option>
					</select>
				</div>
				<div class="field">
					<label for="temp-mode">Temperature input</label>
					<select id="temp-mode">
						<option value="sea-level" selected>Sea-level temperature</option>
						<option value="air">Air temperature</option>
					</select>
				</div>
				<div class="field">
					<label for="pressure-mode">Pressure input</label>
					<select id="pressure-mode">
						<option value="sea-level" selected>Sea-level pressure</option>
						<option value="air">Air pressure</option>
						<option value="altimeter">Altimeter setting</option>
					</select>
				</div>
				<div class="field">
					<label for="units-preset">Units</label>
					<select id="units-preset">
						<option value="default" selected>Default (m, °C, atm, kg, s)</option>
						<option value="si-K-Pa">SI (m, K, Pa, kg, s)</option>
						<option value="si-C-Pa">SI (m, °C, Pa, kg, s)</option>
						<option value="si-K-hPa">SI (m, K, hPa, kg, s)</option>
						<option value="si-C-hPa">SI (m, °C, hPa, kg, s)</option>
						<option value="us-F-atm">US (ft, °F, atm, lb, s)</option>
						<option value="us-R-psi">US (ft, °R, psi, lb, s)</option>
						<option value="us-F-psi">US (ft, °F, psi, lb, s)</option>
						<option value="us-R-inHg">US (ft, °R, inHg, lb, s)</option>
						<option value="us-F-inHg">US (ft, °F, inHg, lb, s)</option>
						<option value="custom">Custom</option>
					</select>
				</div>

			</div>

			<div class="outputs">
				<h2>Outputs</h2>

				<div class="field">
					<label id="lbl-press-out-1">Air pressure</label>
					<div class="output-row">
						<span id="out-pressure">—</span>
						<select id="out-pressure-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="lbl-press-out-2">Altimeter setting</label>
					<div class="output-row">
						<span id="out-press-out-2">—</span>
						<select id="out-press-out-2-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="lbl-temp-output">Air temperature</label>
					<div class="output-row">
						<span id="out-temperature">—</span>
						<select id="out-temperature-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Air density</label>
					<div class="output-row">
						<span id="out-density">—</span>
						<select id="out-density-unit">
							<option value="kg/m3" selected>kg/m³</option>
							<option value="lb/ft3">lb/ft³</option>
							<option value="slug/ft3">slug/ft³</option>
							<option value="sigma">sigma (SL std=1)</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Pressure altitude</label>
					<div class="output-row">
						<span id="out-pressure-altitude">—</span>
						<select id="out-pressure-altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Density altitude</label>
					<div class="output-row">
						<span id="out-density-altitude">—</span>
						<select id="out-density-altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Speed of sound</label>
					<div class="output-row">
						<span id="out-speed-of-sound">—</span>
						<select id="out-speed-of-sound-unit">
							<option value="m/s" selected>m/s</option>
							<option value="km/h">km/h</option>
							<option value="mph">mph</option>
							<option value="ft/s">ft/s</option>
							<option value="kn">knots</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Dynamic viscosity</label>
					<div class="output-row">
						<span id="out-viscosity">—</span>
						<select id="out-viscosity-unit">
							<option value="Pa·s" selected>Pa·s</option>
							<option value="μPa·s">μPa·s</option>
							<option value="P">poise</option>
							<option value="cP">centipoise</option>
							<option value="lbf·s/ft2">lbf·s/ft²</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="out-geo-alt-label">Geopotential altitude</label>
					<div class="output-row">
						<span id="out-geo-alt">—</span>
						<select id="out-geo-alt-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Mean free path</label>
					<div class="output-row">
						<span id="out-mfp">—</span>
						<select id="out-mfp-unit">
							<option value="nm">nm</option>
							<option value="μm">μm</option>
							<option value="mm">mm</option>
							<option value="m" selected>m</option>
							<option value="km">km</option>
							<option value="in">in</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Partial pressure</label>
					<div class="output-row">
						<span id="out-partial-pressure">—</span>
						<select id="out-partial-pressure-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
						<select id="out-partial-pressure-species">
							<option value="N2" selected>N₂</option>
							<option value="O2">O₂</option>
							<option value="Ar">Ar</option>
							<option value="CO2">CO₂</option>
							<option value="O">O</option>
							<option value="He">He</option>
							<option value="H">H</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label>Boiling point of water</label>
					<div class="output-row">
						<span id="out-boiling-point">—</span>
						<select id="out-boiling-point-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
				</div>
			</div>
		</section>

</Layout>

<style>
	.calculator {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.field {
		display: grid;
		grid-template-columns: 10rem 1fr;
		align-items: center;
		column-gap: 0.75rem;
		row-gap: 0.15rem;
		margin-bottom: 0.75rem;
	}

	label {
		font-size: 1rem;
		color: var(--color-text);
	}

	.input-row,
	.output-row {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

	input[type="number"] {
		flex: 1;
		padding: 0.25rem 0.35rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		font-size: 1rem;
		color: var(--color-text);
		background: var(--color-input-bg);
	}

	select {
		padding: 0.25rem 0.35rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		font-size: 1rem;
		background: var(--color-input-bg);
		color: var(--color-text);
	}

	.output-row span {
		flex: 1;
		padding: 0.25rem 0.35rem;
		background: var(--color-output-bg);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		font-size: 1rem;
		min-width: 0;
	}

	.error {
		grid-column: 2;
		color: red;
		font-size: 0.875rem;
		margin: 0;
	}

	.unit-buttons {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}

	.unit-buttons button {
		padding: 0.4rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-button-bg);
		font-size: 0.875rem;
		color: var(--color-text);
		cursor: pointer;
	}

	.unit-buttons button:hover {
		background: var(--color-button-hover);
	}

	@media (max-width: 700px) {
		.calculator {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import {
		geometricToGeopotential, geopotentialToGeometric,
		getPressure, getTemperature, getSeaLevelTemperature, getSeaLevelPressure, getAltimeterSetting,
		getDensity, getPressureAltitude, getDensityAltitude, getBoilingPoint,
		getUpperAtmosphere, P_AT_86KM,
		LOWER_MOLE_FRACTIONS, UPPER_SPECIES_INDEX,
		getMeanFreePath,
		getSpeedOfSound,
	} from '../../../lib/atmosphere.ts';
	import {
		altToM, altFromM, tempToK, tempFromK,
		pressureToPa, pressureFromPa,
		densityFromKgM3, speedFromMS, viscosityFromPaS, mfpFromM,
	} from '../../../lib/convert.ts';

	function fmtBound(n: number): string {
		return parseFloat(n.toPrecision(6)).toString();
	}

	// Boundary between lower and upper atmosphere
	const UPPER_GEOM  = 86000;                              // m geometric
	const UPPER_GEOPOT = geometricToGeopotential(UPPER_GEOM); // ≈ 84852 m geopotential
	const UPPER_GEOPOT_MAX = geometricToGeopotential(1000000); // ≈ 864049 m geopotential

	// Given the altitude input, return { h_m: geometric, H: geopotential | null, isUpper }
	function resolveAltitude(altVal: number, altUnit: string, useGeopot: boolean) {
		const input_m = altToM(altVal, altUnit);
		if (useGeopot) {
			if (input_m > UPPER_GEOPOT) {
				const h_m = geopotentialToGeometric(input_m);
				return { h_m, H: null as number | null, isUpper: true };
			}
			return { h_m: geopotentialToGeometric(input_m), H: input_m, isUpper: false };
		} else {
			if (input_m > UPPER_GEOM) {
				return { h_m: input_m, H: null as number | null, isUpper: true };
			}
			return { h_m: input_m, H: geometricToGeopotential(input_m), isUpper: false };
		}
	}

	function validate(): boolean {
		let valid = true;

		// Altitude
		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const errAlt    = document.getElementById('err-altitude') as HTMLElement;

		let isUpper = false;
		if (!isNaN(altVal)) {
			const input_m = altToM(altVal, altUnit);
			const loM = useGeopot ? -5004 : -5000;
			const hiM = useGeopot ? UPPER_GEOPOT_MAX : 1000000;
			const label = useGeopot ? 'Geopotential altitude' : 'Geometric altitude';
			const factor = altFromM(1, altUnit);
			if (input_m < loM || input_m > hiM) {
				errAlt.textContent = `${label} must be between ${fmtBound(loM * factor)} and ${fmtBound(hiM * factor)} ${altUnit}`;
				valid = false;
			} else {
				errAlt.textContent = '';
				isUpper = useGeopot ? input_m > UPPER_GEOPOT : input_m > UPPER_GEOM;
			}
		} else {
			errAlt.textContent = '';
		}

		const errTemp  = document.getElementById('err-temp') as HTMLElement;
		const errPress = document.getElementById('err-pressure') as HTMLElement;

		// Temperature and pressure inputs don't apply to upper atmosphere model
		if (isUpper) {
			errTemp.textContent = '';
			errPress.textContent = '';
			return valid;
		}

		// Temperature
		const tempVal  = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tempUnit = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const tempMode = (document.getElementById('temp-mode') as HTMLSelectElement).value;

		if (!isNaN(tempVal) && !isNaN(altVal)) {
			const T_input_K = tempToK(tempVal, tempUnit);
			const { H } = resolveAltitude(altVal, altUnit, useGeopot);
			const H_v = H ?? geometricToGeopotential(UPPER_GEOM);
			const T0_K_v = tempMode === 'air' ? getSeaLevelTemperature(H_v, T_input_K) : T_input_K;
			const loK = 173.15, hiK = 373.15;
			const unitLabel = tempUnit === 'C' ? '°C' : tempUnit === 'F' ? '°F' : tempUnit === 'R' ? '°R' : 'K';
			if (T0_K_v < loK || T0_K_v > hiK) {
				errTemp.textContent = `Sea-level temperature must be between ${fmtBound(tempFromK(loK, tempUnit))} and ${fmtBound(tempFromK(hiK, tempUnit))} ${unitLabel}`;
				valid = false;
			} else {
				errTemp.textContent = '';
			}
		} else {
			errTemp.textContent = '';
		}

		// Pressure
		const pressVal  = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;

		if (!isNaN(pressVal)) {
			const P_Pa = pressureToPa(pressVal, pressUnit);
			const toUnit = (p: number) => pressureFromPa(p, pressUnit);
			if (pressMode === 'air') {
				if (P_Pa <= 0 || P_Pa > 1.2 * 101325) {
					errPress.textContent = `Air pressure must be between 0 and ${fmtBound(toUnit(1.2 * 101325))} ${pressUnit}`;
					valid = false;
				} else {
					errPress.textContent = '';
				}
			} else {
				const label = pressMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
				const loP = 0.5 * 101325, hiP = 1.5 * 101325;
				if (P_Pa < loP || P_Pa > hiP) {
					errPress.textContent = `${label} must be between ${fmtBound(toUnit(loP))} and ${fmtBound(toUnit(hiP))} ${pressUnit}`;
					valid = false;
				} else {
					errPress.textContent = '';
				}
			}
		} else {
			errPress.textContent = '';
		}

		return valid;
	}

	function fmt6(n: number): string {
		return n.toPrecision(6);
	}

	function fmtTemp(v: number, unit: string, sigFigs = 6): string {
		if (unit === 'K' || unit === 'R') return v.toPrecision(sigFigs);
		const T_abs = v + (unit === 'C' ? 273.15 : 459.67);
		const digits = Math.max(0, (sigFigs - 1) - Math.floor(Math.log10(Math.abs(T_abs))));
		return v.toFixed(digits);
	}

	function calculate() {
		const outputIds = [
			'out-pressure', 'out-press-out-2', 'out-temperature', 'out-density',
			'out-pressure-altitude', 'out-density-altitude', 'out-speed-of-sound', 'out-viscosity', 'out-boiling-point', 'out-geo-alt',
		];
		if (!validate()) {
			for (const id of outputIds) (document.getElementById(id) as HTMLElement).textContent = '—';
			return;
		}

		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const tempVal   = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tempUnit  = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const pressVal  = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const tempMode  = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;

		if (isNaN(altVal)) return;

		const { h_m, H, isUpper } = resolveAltitude(altVal, altUnit, useGeopot);

		if (isUpper) {
			// ── Upper atmosphere (86–1000 km) ────────────────────────────────────
			// Derive boundary conditions at 86 km from the lower atmosphere so
			// that pressure and temperature are continuous across the boundary.
			const H86 = geometricToGeopotential(86000);
			let T_bc: number, P_bc: number;
			if (!isNaN(tempVal) && !isNaN(pressVal)) {
				const T_input_K  = tempToK(tempVal, tempUnit);
				const P_input_Pa = pressureToPa(pressVal, pressUnit);
				const T0_K = tempMode === 'air' ? getSeaLevelTemperature(H86, T_input_K) : T_input_K;
				let P0_Pa: number;
				if (pressMode === 'sea-level') {
					P0_Pa = P_input_Pa;
				} else if (pressMode === 'air') {
					P0_Pa = getSeaLevelPressure(H86, P_input_Pa, T0_K);
				} else {
					const P_at_bc = P_input_Pa * getPressure(H86, 1, 288.15);
					P0_Pa = getSeaLevelPressure(H86, P_at_bc, T0_K);
				}
				T_bc = getTemperature(H86, T0_K);
				P_bc = getPressure(H86, P0_Pa, T0_K);
			} else {
				T_bc = getTemperature(H86, 288.15);
				P_bc = P_AT_86KM;
			}
			const upperAtm = getUpperAtmosphere(h_m, T_bc, P_bc);
			const T_K  = upperAtm.T;
			const P_Pa = upperAtm.P;
			const rho  = upperAtm.rho;

			const pUnit = (document.getElementById('out-pressure-unit') as HTMLSelectElement).value;
			(document.getElementById('out-pressure') as HTMLElement).textContent = fmt6(pressureFromPa(P_Pa, pUnit));
			// Sea-level pressure and altimeter setting are not defined by the upper atmosphere model
			(document.getElementById('out-press-out-2') as HTMLElement).textContent = 'N/A';

			const tUnit = (document.getElementById('out-temperature-unit') as HTMLSelectElement).value;
			(document.getElementById('out-temperature') as HTMLElement).textContent = fmtTemp(tempFromK(T_K, tUnit), tUnit);

			const dUnit = (document.getElementById('out-density-unit') as HTMLSelectElement).value;
			(document.getElementById('out-density') as HTMLElement).textContent = fmt6(densityFromKgM3(rho, dUnit));

			const pa_m = getPressureAltitude(P_Pa);
			const paUnit = (document.getElementById('out-pressure-altitude-unit') as HTMLSelectElement).value;
			(document.getElementById('out-pressure-altitude') as HTMLElement).textContent = fmt6(altFromM(pa_m, paUnit));

			const da_m = getDensityAltitude(rho);
			const daUnit = (document.getElementById('out-density-altitude-unit') as HTMLSelectElement).value;
			(document.getElementById('out-density-altitude') as HTMLElement).textContent = fmt6(altFromM(da_m, daUnit));

			// Speed of sound: γ varies above 86 km due to atomic O; show N/A above where continuum breaks down
			(document.getElementById('out-speed-of-sound') as HTMLElement).textContent = 'N/A';

			const mu_Pas = 1.458e-6 * Math.pow(T_K, 1.5) / (T_K + 110.4);
			const muUnit = (document.getElementById('out-viscosity-unit') as HTMLSelectElement).value;
			(document.getElementById('out-viscosity') as HTMLElement).textContent = fmt6(viscosityFromPaS(mu_Pas, muUnit));

			const bp_K = getBoilingPoint(P_Pa);
			const bpEl = document.getElementById('out-boiling-point') as HTMLElement;
			bpEl.textContent = bp_K >= 273.16
				? (() => { const u = (document.getElementById('out-boiling-point-unit') as HTMLSelectElement).value; return fmtTemp(tempFromK(bp_K, u), u); })()
				: 'N/A';

			(document.getElementById('out-geo-alt-label') as HTMLElement).textContent =
				useGeopot ? 'Geometric altitude' : 'Geopotential altitude';
			const altOther_m = useGeopot ? h_m : geometricToGeopotential(h_m);
			const geoAltUnit = (document.getElementById('out-geo-alt-unit') as HTMLSelectElement).value;
			(document.getElementById('out-geo-alt') as HTMLElement).textContent = fmt6(altFromM(altOther_m, geoAltUnit));

			const ppSpecies = (document.getElementById('out-partial-pressure-species') as HTMLSelectElement).value;
			const ppUnit    = (document.getElementById('out-partial-pressure-unit') as HTMLSelectElement).value;
			const ppIdx = UPPER_SPECIES_INDEX[ppSpecies];
			const pp_Pa = ppIdx >= 0 ? upperAtm.partialP[ppIdx] : 0;
			(document.getElementById('out-partial-pressure') as HTMLElement).textContent = fmt6(pressureFromPa(pp_Pa, ppUnit));

			const mfpUnit = (document.getElementById('out-mfp-unit') as HTMLSelectElement).value;
			(document.getElementById('out-mfp') as HTMLElement).textContent = fmt6(mfpFromM(getMeanFreePath(P_Pa, T_K), mfpUnit));

		} else {
			// ── Lower atmosphere (−5 to 86 km): custom sea-level conditions ─────
			if (isNaN(tempVal) || isNaN(pressVal)) return;
			const H_lower = H!;
			const P_input_Pa = pressureToPa(pressVal, pressUnit);
			const T_input_K  = tempToK(tempVal, tempUnit);
			const T0_K = tempMode === 'air' ? getSeaLevelTemperature(H_lower, T_input_K) : T_input_K;

			let P_Pa: number, P0_Pa: number, altimeter_Pa: number;
			if (pressMode === 'sea-level') {
				P0_Pa = P_input_Pa;
				P_Pa  = getPressure(H_lower, P0_Pa, T0_K);
				altimeter_Pa = getAltimeterSetting(H_lower, P_Pa);
			} else if (pressMode === 'air') {
				P_Pa  = P_input_Pa;
				P0_Pa = getSeaLevelPressure(H_lower, P_Pa, T0_K);
				altimeter_Pa = getAltimeterSetting(H_lower, P_Pa);
			} else {
				altimeter_Pa = P_input_Pa;
				P_Pa  = altimeter_Pa * getPressure(H_lower, 1, 288.15);
				P0_Pa = getSeaLevelPressure(H_lower, P_Pa, T0_K);
			}

			const T_K = getTemperature(H_lower, T0_K);

			const out1_Pa = pressMode === 'air' ? P0_Pa : P_Pa;
			const pUnit = (document.getElementById('out-pressure-unit') as HTMLSelectElement).value;
			(document.getElementById('out-pressure') as HTMLElement).textContent = fmt6(pressureFromPa(out1_Pa, pUnit));

			const out2_Pa = pressMode === 'altimeter' ? P0_Pa : altimeter_Pa;
			const p2Unit = (document.getElementById('out-press-out-2-unit') as HTMLSelectElement).value;
			(document.getElementById('out-press-out-2') as HTMLElement).textContent = fmt6(pressureFromPa(out2_Pa, p2Unit));

			const tUnit = (document.getElementById('out-temperature-unit') as HTMLSelectElement).value;
			const tOut  = tempMode === 'air' ? T0_K : T_K;
			(document.getElementById('out-temperature') as HTMLElement).textContent = fmtTemp(tempFromK(tOut, tUnit), tUnit);

			const rho   = getDensity(P_Pa, T_K);
			const dUnit = (document.getElementById('out-density-unit') as HTMLSelectElement).value;
			(document.getElementById('out-density') as HTMLElement).textContent = fmt6(densityFromKgM3(rho, dUnit));

			const pa_m   = getPressureAltitude(P_Pa);
			const paUnit = (document.getElementById('out-pressure-altitude-unit') as HTMLSelectElement).value;
			const pa_out = altFromM(pa_m, paUnit);
			(document.getElementById('out-pressure-altitude') as HTMLElement).textContent =
				Math.abs(pa_out) > 1 ? fmt6(pa_out) : pa_out.toFixed(5);

			const da_m   = getDensityAltitude(rho);
			const daUnit = (document.getElementById('out-density-altitude-unit') as HTMLSelectElement).value;
			const da_out = altFromM(da_m, daUnit);
			(document.getElementById('out-density-altitude') as HTMLElement).textContent =
				Math.abs(da_out) > 1 ? fmt6(da_out) : da_out.toFixed(5);

			const sos_ms = getSpeedOfSound(P_Pa, rho);
			const sosUnit = (document.getElementById('out-speed-of-sound-unit') as HTMLSelectElement).value;
			(document.getElementById('out-speed-of-sound') as HTMLElement).textContent = fmt6(speedFromMS(sos_ms, sosUnit));

			const mu_Pas = 1.458e-6 * Math.pow(T_K, 1.5) / (T_K + 110.4);
			const muUnit = (document.getElementById('out-viscosity-unit') as HTMLSelectElement).value;
			(document.getElementById('out-viscosity') as HTMLElement).textContent = fmt6(viscosityFromPaS(mu_Pas, muUnit));

			const bp_K = getBoilingPoint(P_Pa);
			const bpEl = document.getElementById('out-boiling-point') as HTMLElement;
			bpEl.textContent = bp_K >= 273.16
				? (() => { const u = (document.getElementById('out-boiling-point-unit') as HTMLSelectElement).value; return fmtTemp(tempFromK(bp_K, u), u); })()
				: 'N/A';

			(document.getElementById('out-geo-alt-label') as HTMLElement).textContent =
				useGeopot ? 'Geometric altitude' : 'Geopotential altitude';
			const altOther_m = useGeopot ? geopotentialToGeometric(H_lower) : H_lower;
			const geoAltUnit = (document.getElementById('out-geo-alt-unit') as HTMLSelectElement).value;
			(document.getElementById('out-geo-alt') as HTMLElement).textContent = fmt6(altFromM(altOther_m, geoAltUnit));

			const ppSpecies = (document.getElementById('out-partial-pressure-species') as HTMLSelectElement).value;
			const ppUnit    = (document.getElementById('out-partial-pressure-unit') as HTMLSelectElement).value;
			const pp_Pa = P_Pa * (LOWER_MOLE_FRACTIONS[ppSpecies] ?? 0);
			(document.getElementById('out-partial-pressure') as HTMLElement).textContent = fmt6(pressureFromPa(pp_Pa, ppUnit));

			const mfpUnit = (document.getElementById('out-mfp-unit') as HTMLSelectElement).value;
			(document.getElementById('out-mfp') as HTMLElement).textContent = fmt6(mfpFromM(getMeanFreePath(P_Pa, T_K), mfpUnit));
		}
	}

	const inputIds = [
		'altitude', 'altitude-unit',
		'sea-level-temp', 'sea-level-temp-unit',
		'sea-level-pressure', 'sea-level-pressure-unit',
		'altitude-mode', 'temp-mode', 'pressure-mode',
		'out-pressure-unit', 'out-press-out-2-unit', 'out-temperature-unit', 'out-density-unit',
		'out-pressure-altitude-unit', 'out-density-altitude-unit', 'out-speed-of-sound-unit',
		'out-viscosity-unit', 'out-boiling-point-unit', 'out-geo-alt-unit',
		'out-mfp-unit', 'out-partial-pressure-species', 'out-partial-pressure-unit',
	];

	for (const id of inputIds) {
		const el = document.getElementById(id)!;
		el.addEventListener('input', calculate);
		el.addEventListener('change', calculate);
	}

	function updateTempLabels() {
		const airMode = (document.getElementById('temp-mode') as HTMLSelectElement).value === 'air';
		(document.getElementById('lbl-temp-input') as HTMLElement).textContent  = airMode ? 'Air temperature' : 'Sea-level temperature';
		(document.getElementById('lbl-temp-output') as HTMLElement).textContent = airMode ? 'Sea-level temperature' : 'Air temperature';
	}

	function updateStdNote() {
		const tempUnit  = (document.getElementById('sea-level-temp-unit')      as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sea-level-pressure-unit')  as HTMLSelectElement).value;
		const fmt = (n: number) => parseFloat(n.toPrecision(6)).toString();
		const stdT = tempUnit === 'F' ? fmt(59) : tempUnit === 'K' ? fmt(288.15) : tempUnit === 'R' ? fmt(518.67) : fmt(15);
		const tLabel = tempUnit === 'F' ? '°F' : tempUnit === 'K' ? 'K' : tempUnit === 'R' ? '°R' : '°C';
		const stdP = pressUnit === 'Pa'   ? fmt(101325)
		           : pressUnit === 'hPa'  ? fmt(1013.25)
		           : pressUnit === 'kPa'  ? fmt(101.325)
		           : pressUnit === 'mmHg' ? fmt(760)
		           : pressUnit === 'inHg' ? fmt(29.9212598)
		           : pressUnit === 'psi'  ? fmt(14.6959488)
		           : fmt(1);
		(document.getElementById('std-conditions-note') as HTMLElement).textContent =
			`Standard sea-level conditions are ${stdT} ${tLabel} and ${stdP} ${pressUnit}.`;
	}

	function updatePressureLabels() {
		const mode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		const inputLabel = mode === 'air' ? 'Air pressure' : mode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
		(document.getElementById('lbl-pressure-input') as HTMLElement).textContent = inputLabel;
		const [out1, out2] = mode === 'air'
			? ['Sea-level pressure', 'Altimeter setting']
			: mode === 'altimeter'
			? ['Air pressure', 'Sea-level pressure']
			: ['Air pressure', 'Altimeter setting'];
		(document.getElementById('lbl-press-out-1') as HTMLElement).textContent = out1;
		(document.getElementById('lbl-press-out-2') as HTMLElement).textContent = out2;
	}

	type UnitPreset = { alt: string; temp: string; press: string; dens: string; speed: string; visc: string; mfp: string; };
	const PRESETS: Record<string, UnitPreset> = {
		'default':   { alt: 'm',  temp: 'C', press: 'atm',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-K-Pa':   { alt: 'm',  temp: 'K', press: 'Pa',   dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-C-Pa':   { alt: 'm',  temp: 'C', press: 'Pa',   dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-K-hPa':  { alt: 'm',  temp: 'K', press: 'hPa',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-C-hPa':  { alt: 'm',  temp: 'C', press: 'hPa',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'us-F-atm':  { alt: 'ft', temp: 'F', press: 'atm',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-R-psi':  { alt: 'ft', temp: 'R', press: 'psi',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-F-psi':  { alt: 'ft', temp: 'F', press: 'psi',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-R-inHg': { alt: 'ft', temp: 'R', press: 'inHg', dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-F-inHg': { alt: 'ft', temp: 'F', press: 'inHg', dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
	};

	let applyingPreset = false;

	function applyPreset(key: string) {
		const p = PRESETS[key];
		if (!p) return;
		applyingPreset = true;

		// Convert input values to new units
		const altVal  = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const tmpVal  = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tmpUnit = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const prVal   = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const prUnit  = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;

		if (!isNaN(altVal))
			(document.getElementById('altitude') as HTMLInputElement).value =
				parseFloat(altFromM(altToM(altVal, altUnit), p.alt).toPrecision(6)).toString();
		if (!isNaN(tmpVal))
			(document.getElementById('sea-level-temp') as HTMLInputElement).value =
				parseFloat(tempFromK(tempToK(tmpVal, tmpUnit), p.temp).toPrecision(6)).toString();
		if (!isNaN(prVal))
			(document.getElementById('sea-level-pressure') as HTMLInputElement).value =
				parseFloat(pressureFromPa(pressureToPa(prVal, prUnit), p.press).toPrecision(6)).toString();

		// Set all unit selects
		const set = (id: string, v: string) => { (document.getElementById(id) as HTMLSelectElement).value = v; };
		set('altitude-unit',             p.alt);
		set('sea-level-temp-unit',       p.temp);
		set('sea-level-pressure-unit',   p.press);
		set('out-pressure-unit',         p.press);
		set('out-press-out-2-unit',      p.press);
		set('out-temperature-unit',      p.temp);
		set('out-density-unit',          p.dens);
		set('out-pressure-altitude-unit', p.alt);
		set('out-density-altitude-unit', p.alt);
		set('out-speed-of-sound-unit',   p.speed);
		set('out-viscosity-unit',        p.visc);
		set('out-boiling-point-unit',      p.temp);
		set('out-geo-alt-unit',            p.alt);
		set('out-mfp-unit',                p.mfp);
		set('out-partial-pressure-unit',   p.press);

		applyingPreset = false;
		updateStdNote();
		calculate();
	}

	// Revert to Custom when user changes any unit dropdown directly
	const unitDropdownIds = [
		'altitude-unit', 'sea-level-temp-unit', 'sea-level-pressure-unit',
		'out-pressure-unit', 'out-press-out-2-unit', 'out-temperature-unit',
		'out-density-unit', 'out-pressure-altitude-unit', 'out-density-altitude-unit',
		'out-speed-of-sound-unit', 'out-viscosity-unit', 'out-boiling-point-unit', 'out-geo-alt-unit',
		'out-mfp-unit', 'out-partial-pressure-unit',
	];
	for (const id of unitDropdownIds) {
		document.getElementById(id)!.addEventListener('change', () => {
			if (!applyingPreset)
				(document.getElementById('units-preset') as HTMLSelectElement).value = 'custom';
		});
	}

	document.getElementById('units-preset')!.addEventListener('change', () => {
		const val = (document.getElementById('units-preset') as HTMLSelectElement).value;
		if (val !== 'custom') applyPreset(val);
	});

	document.getElementById('temp-mode')!.addEventListener('change', () => { updateTempLabels(); calculate(); });
	document.getElementById('pressure-mode')!.addEventListener('change', () => { updatePressureLabels(); calculate(); });
	document.getElementById('sea-level-temp-unit')!.addEventListener('change', updateStdNote);
	document.getElementById('sea-level-pressure-unit')!.addEventListener('change', updateStdNote);
	updateTempLabels();
	updatePressureLabels();
	updateStdNote();
	calculate();

	document.getElementById('btn-reset')!.addEventListener('click', () => {
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const tempUnit  = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;

		// Standard conditions: 0 m, 288.15 K, 101325 Pa — converted to current input units
		const alt_out = altUnit === 'ft' ? 0 : altUnit === 'mi' ? 0 : altUnit === 'km' ? 0 : 0;
		const temp_out = tempUnit === 'C' ? 15
		               : tempUnit === 'F' ? 59
		               : tempUnit === 'R' ? 518.67
		               : 288.15;
		const press_out = pressUnit === 'Pa'   ? 101_325
		                : pressUnit === 'hPa'  ? 1013.25
		                : pressUnit === 'kPa'  ? 101.325
		                : pressUnit === 'mmHg' ? 760
		                : pressUnit === 'inHg' ? 29.9213
		                : pressUnit === 'psi'  ? 14.6959
		                : 1;

		(document.getElementById('altitude') as HTMLInputElement).value = String(alt_out);
		(document.getElementById('sea-level-temp') as HTMLInputElement).value = String(temp_out);
		(document.getElementById('sea-level-pressure') as HTMLInputElement).value = String(press_out);
		calculate();
	});
</script>
