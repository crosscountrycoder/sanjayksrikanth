---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AtmosphereNav from '../../../components/AtmosphereNav.astro';
---

<Layout title="Standard Atmosphere Calculator">
	<Breadcrumb crumbs={[
			{ label: 'Home', href: '/' },
			{ label: 'Calculators', href: '/calculators' },
			{ label: 'Standard Atmosphere Calculator' },
		]} />
		<h1>Standard Atmosphere Calculator</h1>
		<AtmosphereNav active="calculator" />
		<p>
		Calculates atmospheric properties at a given altitude using a version of
		the <a href="https://en.wikipedia.org/wiki/U.S._Standard_Atmosphere" target="_blank">U.S. Standard Atmosphere 1976 model</a>, with adjustable 
		sea-level conditions.
		</p>

		<section class="calculator">
			<div class="inputs">
				<h2>Inputs</h2>

				<div class="field">
					<label for="altitude" id="lbl-altitude" data-tooltip="Height above mean sea level along the local vertical.">Geometric altitude</label>
					<div class="input-row">
						<input type="number" id="altitude" value="0" />
						<select id="altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
					<p class="error" id="err-altitude"></p>
				</div>

				<div class="field">
					<label for="sea-level-temp" id="lbl-temp-input" data-tooltip="Air temperature at sea level, used as the baseline for the atmospheric temperature profile.">Sea-level temperature</label>
					<div class="input-row">
						<input type="number" id="sea-level-temp" value="15" />
						<select id="sea-level-temp-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
					<p class="error" id="err-temp"></p>
				</div>

				<div class="field">
					<label for="sea-level-pressure" id="lbl-pressure-input" data-tooltip="Atmospheric pressure at sea level, the starting point for the pressure integration.">Sea-level pressure</label>
					<div class="input-row">
						<input type="number" id="sea-level-pressure" value="1" />
						<select id="sea-level-pressure-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
					<p class="error" id="err-pressure"></p>
				</div>

				<p id="std-conditions-note" style="font-style:italic;"></p>

				<div class="unit-buttons">
					<button id="btn-reset">Reset to standard conditions</button>
				</div>

				<h3>Settings</h3>
				<div class="field">
					<label for="altitude-mode">Altitude input</label>
					<select id="altitude-mode">
						<option value="geometric" selected>Geometric</option>
						<option value="geopotential">Geopotential</option>
					</select>
				</div>
				<div class="field">
					<label for="temp-mode">Temperature input</label>
					<select id="temp-mode">
						<option value="sea-level" selected>Sea-level temperature</option>
						<option value="air">Air temperature</option>
					</select>
				</div>
				<div class="field">
					<label for="pressure-mode">Pressure input</label>
					<select id="pressure-mode">
						<option value="sea-level" selected>Sea-level pressure</option>
						<option value="air">Air pressure</option>
						<option value="altimeter">Altimeter setting</option>
					</select>
				</div>
				<div class="field">
					<label for="units-preset">Units</label>
					<select id="units-preset">
						<option value="default" selected>Default (m, °C, atm, kg, s)</option>
						<option value="si-K-Pa">SI (m, K, Pa, kg, s)</option>
						<option value="si-C-Pa">SI (m, °C, Pa, kg, s)</option>
						<option value="si-K-hPa">SI (m, K, hPa, kg, s)</option>
						<option value="si-C-hPa">SI (m, °C, hPa, kg, s)</option>
						<option value="us-F-atm">US (ft, °F, atm, lb, s)</option>
						<option value="us-R-psi">US (ft, °R, psi, lb, s)</option>
						<option value="us-F-psi">US (ft, °F, psi, lb, s)</option>
						<option value="us-R-inHg">US (ft, °R, inHg, lb, s)</option>
						<option value="us-F-inHg">US (ft, °F, inHg, lb, s)</option>
						<option value="custom">Custom</option>
					</select>
				</div>

			</div>

			<div class="outputs">
				<h2>Outputs</h2>

				<div class="field">
					<label id="lbl-press-out-1" data-tooltip="Absolute atmospheric pressure at the given altitude.">Air pressure</label>
					<div class="output-row">
						<span id="out-pressure">—</span>
						<select id="out-pressure-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="lbl-press-out-2" data-tooltip="Sea-level pressure derived from station pressure using a standard temperature profile; used to calibrate aircraft altimeters.">Altimeter setting</label>
					<div class="output-row">
						<span id="out-press-out-2">—</span>
						<select id="out-press-out-2-unit">
							<option value="atm" selected>atm</option>
							<option value="Pa">Pa</option>
							<option value="hPa">hPa (mbar)</option>
							<option value="kPa">kPa</option>
							<option value="mmHg">mmHg (Torr)</option>
							<option value="inHg">inHg</option>
							<option value="psi">psi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="lbl-temp-output" data-tooltip="Atmospheric temperature at the given altitude.">Air temperature</label>
					<div class="output-row">
						<span id="out-temperature">—</span>
						<select id="out-temperature-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Mass of air per unit volume, computed from pressure, temperature, and molar mass via the ideal gas law.">Air density</label>
					<div class="output-row">
						<span id="out-density">—</span>
						<select id="out-density-unit">
							<option value="kg/m3" selected>kg/m³</option>
							<option value="lb/ft3">lb/ft³</option>
							<option value="slug/ft3">slug/ft³</option>
							<option value="sigma">sigma (SL std=1)</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Altitude in the standard atmosphere where pressure equals the current pressure; used in aviation for flight levels.">Pressure altitude</label>
					<div class="output-row">
						<span id="out-pressure-altitude">—</span>
						<select id="out-pressure-altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Altitude in the standard atmosphere where density equals the current density; determines aircraft aerodynamic and engine performance.">Density altitude</label>
					<div class="output-row">
						<span id="out-density-altitude">—</span>
						<select id="out-density-altitude-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label id="out-geo-alt-label" data-tooltip="Geopotential altitude corresponding to the input geometric altitude.">Geopotential altitude</label>
					<div class="output-row">
						<span id="out-geo-alt">—</span>
						<select id="out-geo-alt-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Mean molecular mass of the air mixture at this altitude; decreases above ~90 km as lighter species dominate.">Molar mass</label>
					<div class="output-row">
						<span id="out-molar-mass">—</span>
						<select disabled><option>g/mol</option></select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Speed of acoustic waves in air, equal to √(γRT/M) with γ = 1.4.">Speed of sound</label>
					<div class="output-row">
						<span id="out-speed-of-sound">—</span>
						<select id="out-speed-of-sound-unit">
							<option value="m/s" selected>m/s</option>
							<option value="km/h">km/h</option>
							<option value="mph">mph</option>
							<option value="ft/s">ft/s</option>
							<option value="kn">knots</option>
						</select>
					</div>
					<p class="error" id="err-speed-of-sound"></p>
				</div>

				<div class="field">
					<label data-tooltip="Resistance of air to shear deformation, computed via Sutherland's viscosity formula.">Dynamic viscosity</label>
					<div class="output-row">
						<span id="out-viscosity">—</span>
						<select id="out-viscosity-unit">
							<option value="Pa·s" selected>Pa·s</option>
							<option value="μPa·s">μPa·s</option>
							<option value="mPa·s">mPa·s (cP)</option>
							<option value="lbf·s/ft2">lbf·s/ft²</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Average distance a molecule travels between collisions.">Mean free path</label>
					<div class="output-row">
						<span id="out-mfp">—</span>
						<select id="out-mfp-unit">
							<option value="nm">nm</option>
							<option value="μm">μm</option>
							<option value="mm">mm</option>
							<option value="m" selected>m</option>
							<option value="km">km</option>
							<option value="in">in</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Altitude over which pressure/density would decay by a factor of e if temperature, molar mass, and gravity stayed constant — RT/(Mg).">Scale height</label>
					<div class="output-row">
						<span id="out-scale-height">—</span>
						<select id="out-scale-height-unit">
							<option value="m" selected>m</option>
							<option value="ft">ft</option>
							<option value="mi">mi</option>
							<option value="km">km</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Number (or moles) of particles of the selected gas species per unit volume; select Total for all species combined.">Number density</label>
					<div class="output-row">
						<span id="out-molecular-density">—</span>
						<select id="out-molecular-density-unit">
							<option value="per_m3" selected>/m³</option>
							<option value="per_L">/L</option>
							<option value="per_ft3">/ft³</option>
							<option value="mol_m3">mol/m³</option>
							<option value="kmol_m3">kmol/m³ (mol/L)</option>
							<option value="lbmol_ft3">lbmol/ft³</option>
						</select>
						<select id="out-molecular-density-species">
							<option value="total" selected>Total</option>
							<option value="N2">N₂</option>
							<option value="O2">O₂</option>
							<option value="Ar">Ar</option>
							<option value="CO2">CO₂</option>
							<option value="Ne">Ne</option>
							<option value="He">He</option>
							<option value="CH4">CH₄</option>
							<option value="Kr">Kr</option>
							<option value="H2">H₂</option>
							<option value="N2O">N₂O</option>
							<option value="Xe">Xe</option>
							<option value="O">O</option>
							<option value="H">H</option>
							<option value="N">N</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Share of total particles that are the selected gas species; select Total for all species combined (always 1).">Mole fraction</label>
					<div class="output-row">
						<span id="out-mole-fraction">—</span>
						<select id="out-mole-fraction-species">
							<option value="total" selected>Total</option>
							<option value="N2">N₂</option>
							<option value="O2">O₂</option>
							<option value="Ar">Ar</option>
							<option value="CO2">CO₂</option>
							<option value="Ne">Ne</option>
							<option value="He">He</option>
							<option value="CH4">CH₄</option>
							<option value="Kr">Kr</option>
							<option value="H2">H₂</option>
							<option value="N2O">N₂O</option>
							<option value="Xe">Xe</option>
							<option value="O">O</option>
							<option value="H">H</option>
							<option value="N">N</option>
						</select>
					</div>
				</div>

				<div class="field">
					<label data-tooltip="Temperature at which water boils at the current atmospheric pressure; falls below 100°C at altitude.">Boiling point of water</label>
					<div class="output-row">
						<span id="out-boiling-point">—</span>
						<select id="out-boiling-point-unit">
							<option value="C" selected>°C</option>
							<option value="F">°F</option>
							<option value="K">K</option>
							<option value="R">°R</option>
						</select>
					</div>
					<p class="error" id="err-boiling-point"></p>
				</div>
			</div>
		</section>

</Layout>

<style>
	.calculator {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.field {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: center;
		column-gap: 0.75rem;
		row-gap: 0.15rem;
		margin-bottom: 0.75rem;
	}

	.input-row,
	.output-row {
		gap: 0.5rem;
		overflow-x: auto;
	}

	input[type="number"] {
		flex: 1;
		min-width: 5rem;
	}

	select {
		min-width: 0;
	}

	.output-row span {
		flex: 1;
		min-width: 5rem;
	}

	.error {
		grid-column: 2;
	}

	.unit-buttons {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 700px) {
		.calculator {
			grid-template-columns: 1fr;
		}

		.field {
			grid-template-columns: 8rem minmax(0, 1fr);
		}
	}

	label[data-tooltip] {
		text-decoration: underline dotted;
		cursor: help;
		position: relative;
	}

	label[data-tooltip]::after {
		content: attr(data-tooltip);
		position: absolute;
		left: 0;
		top: calc(100% + 4px);
		width: 16rem;
		padding: 0.3rem 0.5rem;
		background: var(--color-output-bg);
		border: 1px solid var(--color-border);
		border-radius: 3px;
		color: var(--color-text);
		font-size: 0.8125rem;
		font-weight: normal;
		white-space: normal;
		z-index: 100;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s;
	}

	label[data-tooltip]:hover::after {
		opacity: 1;
	}
</style>

<script>
	import * as atm from '../../../lib/atmosphere.ts';
	import { getBoilingPoint } from '../../../lib/water-properties.ts';
	import { convert } from '../../../lib/convert.ts';
	import { roundSig, getStandardConditionsNote } from '../../../lib/helpers.ts';

	const GEOPOT_MIN = atm.geometricToGeopotential(-5000); // ≈ -5003.94 m geopotential
	const GEOPOT_MAX = atm.geometricToGeopotential(1000000); // ≈ 864071 m geopotential
	const AIR_TEMP_MAX_GEOPOT = 20000; // m — above this, air temperature no longer depends on sea-level temp, so "Air temperature" input mode is unavailable

	function resolveAltitude(altVal: number, altUnit: string, useGeopot: boolean) {
		const input_m = convert(altVal, altUnit, 'm');
		const h_m = useGeopot ? atm.geopotentialToGeometric(input_m) : input_m;
		return { h_m };
	}

	// Above 20 km geopotential, sea-level temp has no effect on air temp at all, so back-solving
	// sea-level temp from an entered air temp is meaningless there — disable the "Air temperature"
	// option and fall back to "Sea-level temperature" mode if it was selected.
	function syncTempModeAvailability() {
		const tempModeSel = document.getElementById('temp-mode') as HTMLSelectElement;
		const airOption   = tempModeSel.querySelector('option[value="air"]') as HTMLOptionElement;
		const altVal      = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit     = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const useGeopot   = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';

		if (isNaN(altVal)) {
			airOption.disabled = false;
			return;
		}
		const { h_m } = resolveAltitude(altVal, altUnit, useGeopot);
		const aboveLimit = atm.geometricToGeopotential(h_m) > AIR_TEMP_MAX_GEOPOT;
		airOption.disabled = aboveLimit;
		if (aboveLimit && tempModeSel.value === 'air') {
			tempModeSel.value = 'sea-level';
			updateTempLabels();
		}
	}

	function validate(): boolean {
		let valid = true;

		// Altitude
		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const errAlt    = document.getElementById('err-altitude') as HTMLElement;
		const tempMode  = (document.getElementById('temp-mode') as HTMLSelectElement).value;

		if (!isNaN(altVal)) {
			const input_m = convert(altVal, altUnit, 'm');
			const loM = useGeopot ? GEOPOT_MIN : -5000;
			const hiM = useGeopot ? GEOPOT_MAX : 1000000;
			const label = useGeopot ? 'Geopotential altitude' : 'Geometric altitude';
			const factor = convert(1, 'm', altUnit);
			if (input_m < loM || input_m > hiM) {
				errAlt.textContent = `${label} must be between ${roundSig(loM * factor, 6, 1e-6, true)} and ${roundSig(hiM * factor, 6, 1e-6, true)} ${altUnit}`;
				valid = false;
			} else {
				errAlt.textContent = '';
			}
		} else {
			errAlt.textContent = '';
		}

		const errTemp  = document.getElementById('err-temp') as HTMLElement;
		const errPress = document.getElementById('err-pressure') as HTMLElement;

		// Temperature
		const tempVal  = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tempUnit = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;

		if (!isNaN(tempVal) && !isNaN(altVal)) {
			const T_input_K = convert(tempVal, tempUnit, 'K');
			const { h_m: z_v } = resolveAltitude(altVal, altUnit, useGeopot);
			const T0_K_v = tempMode === 'air' ? atm.getSeaLevelTemperature(z_v, T_input_K) : T_input_K;
			const loK = atm.SEA_LEVEL_TEMP_MIN_K, hiK = atm.SEA_LEVEL_TEMP_MAX_K;
			const unitLabel = tempUnit === 'C' ? '°C' : tempUnit === 'F' ? '°F' : tempUnit === 'R' ? '°R' : 'K';
			if (isNaN(T0_K_v) || T0_K_v < loK || T0_K_v > hiK) {
				if (tempMode === 'air') {
					const fmtT = (K: number) => parseFloat(convert(K, 'K', tempUnit).toFixed(3)).toString();
					const xK = atm.getTemperature(z_v, hiK);
					errTemp.textContent = `Temperature at this altitude must be between ${fmtT(loK)} and ${fmtT(xK)} ${unitLabel}`;
				} else {
					errTemp.textContent = `Sea-level temperature must be between ${roundSig(convert(loK, 'K', tempUnit), 6, 1e-6, true)} and ${roundSig(convert(hiK, 'K', tempUnit), 6, 1e-6, true)} ${unitLabel}`;
				}
				valid = false;
			} else {
				errTemp.textContent = '';
			}
		} else {
			errTemp.textContent = '';
		}

		// Pressure
		const pressVal  = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;

		if (!isNaN(pressVal)) {
			const P_Pa = convert(pressVal, pressUnit, 'Pa');
			const label = pressMode === 'air' ? 'Air pressure' : pressMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
			if (P_Pa <= 0) {
				errPress.textContent = `${label} must be greater than 0 ${pressUnit}`;
				valid = false;
			} else {
				errPress.textContent = '';
			}
		} else {
			errPress.textContent = '';
		}

		return valid;
	}

	function calculate() {
		syncTempModeAvailability();
		updateStdNote();

		const outputIds = [
			'out-pressure', 'out-press-out-2', 'out-temperature', 'out-density',
			'out-pressure-altitude', 'out-density-altitude', 'out-speed-of-sound', 'out-scale-height', 'out-viscosity', 'out-boiling-point', 'out-geo-alt',
			'out-mfp', 'out-molar-mass', 'out-molecular-density', 'out-mole-fraction',
		];
		if (!validate()) {
			for (const id of outputIds) (document.getElementById(id) as HTMLElement).textContent = '—';
			(document.getElementById('err-boiling-point') as HTMLElement).textContent = '';
			(document.getElementById('err-speed-of-sound') as HTMLElement).textContent = '';
			return;
		}

		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const tempVal   = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tempUnit  = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const pressVal  = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const tempMode  = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;

		if (isNaN(altVal)) return;

		const { h_m } = resolveAltitude(altVal, altUnit, useGeopot);

		if (isNaN(tempVal) || isNaN(pressVal)) return;
		const T_input_K  = convert(tempVal, tempUnit, 'K');
		const P_input_Pa = convert(pressVal, pressUnit, 'Pa');
		const T0_K = tempMode === 'air' ? atm.getSeaLevelTemperature(h_m, T_input_K) : T_input_K;

		// Pressure: derive P_Pa, P0_Pa, and altimeter setting
		let P_Pa: number, P0_Pa: number, altimeter_Pa: number | null;
		if (pressMode === 'sea-level') {
			P0_Pa        = P_input_Pa;
			P_Pa         = atm.getPressure(h_m, P0_Pa, T0_K);
			altimeter_Pa = atm.getAltimeterSetting(h_m, P_Pa);
		} else if (pressMode === 'air') {
			P_Pa         = P_input_Pa;
			P0_Pa        = atm.getSeaLevelPressure(h_m, P_Pa, T0_K);
			altimeter_Pa = atm.getAltimeterSetting(h_m, P_Pa);
		} else { // altimeter
			altimeter_Pa = P_input_Pa;
			P_Pa         = altimeter_Pa * atm.getPressure(h_m, 1, 288.15);
			P0_Pa        = atm.getSeaLevelPressure(h_m, P_Pa, T0_K);
		}

		const T_K = atm.getTemperature(h_m, T0_K);
		const rho = atm.getDensity(P_Pa, T_K, h_m);

		const out1_Pa = pressMode === 'air' ? P0_Pa : P_Pa;
		const pUnit = (document.getElementById('out-pressure-unit') as HTMLSelectElement).value;
		(document.getElementById('out-pressure') as HTMLElement).textContent = roundSig(convert(out1_Pa, 'Pa', pUnit), 6);

		const out2_Pa = pressMode === 'altimeter' ? P0_Pa : altimeter_Pa;
		const p2Unit  = (document.getElementById('out-press-out-2-unit') as HTMLSelectElement).value;
		(document.getElementById('out-press-out-2') as HTMLElement).textContent =
			out2_Pa !== null ? roundSig(convert(out2_Pa, 'Pa', p2Unit), 6) : 'N/A';

		const tUnit = (document.getElementById('out-temperature-unit') as HTMLSelectElement).value;
		const tOut  = tempMode === 'air' ? T0_K : T_K;
		(document.getElementById('out-temperature') as HTMLElement).textContent = roundSig(convert(tOut, 'K', tUnit), 6, 1e-4, false, tUnit);

		const dUnit = (document.getElementById('out-density-unit') as HTMLSelectElement).value;
		(document.getElementById('out-density') as HTMLElement).textContent = roundSig(convert(rho, 'kg/m3', dUnit), 6);

		const pa_m   = atm.getPressureAltitude(P_Pa);
		const paUnit = (document.getElementById('out-pressure-altitude-unit') as HTMLSelectElement).value;
		const pa_out = convert(pa_m, 'm', paUnit);
		(document.getElementById('out-pressure-altitude') as HTMLElement).textContent =
			isNaN(pa_m) ? 'N/A' : roundSig(pa_out, 6);

		const da_m   = atm.getDensityAltitude(rho);
		const daUnit = (document.getElementById('out-density-altitude-unit') as HTMLSelectElement).value;
		const da_out = convert(da_m, 'm', daUnit);
		(document.getElementById('out-density-altitude') as HTMLElement).textContent =
			isNaN(da_m) ? 'N/A' : roundSig(da_out, 6);

		const sos_ms  = atm.getSpeedOfSound(T_K, atm.getMolarMass(h_m));
		const sosUnit = (document.getElementById('out-speed-of-sound-unit') as HTMLSelectElement).value;
		(document.getElementById('out-speed-of-sound') as HTMLElement).textContent = roundSig(convert(sos_ms, 'm/s', sosUnit), 6);
		(document.getElementById('err-speed-of-sound') as HTMLElement).textContent = P_Pa < 0.01
			? 'At this pressure, air is too thin for normal sound propagation. The displayed sound speed is theoretical.'
			: '';

		const H_scale  = atm.getScaleHeight(T_K, atm.getMolarMass(h_m), h_m);
		const shUnit   = (document.getElementById('out-scale-height-unit') as HTMLSelectElement).value;
		(document.getElementById('out-scale-height') as HTMLElement).textContent = roundSig(convert(H_scale, 'm', shUnit), 6);

		const mu_Pas = atm.getViscosity(T_K);
		const muUnit = (document.getElementById('out-viscosity-unit') as HTMLSelectElement).value;
		(document.getElementById('out-viscosity') as HTMLElement).textContent = roundSig(convert(mu_Pas, 'Pa·s', muUnit), 6);

		const bp_K = getBoilingPoint(P_Pa);
		const bpEl = document.getElementById('out-boiling-point') as HTMLElement;
		const errBoilingPoint = document.getElementById('err-boiling-point') as HTMLElement;
		if (bp_K >= 273.16) {
			const u = (document.getElementById('out-boiling-point-unit') as HTMLSelectElement).value;
			bpEl.textContent = roundSig(convert(bp_K, 'K', u), 6, 1e-4, false, u);
			errBoilingPoint.textContent = '';
		} else {
			bpEl.textContent = 'N/A';
			// "Air pressure" is the raw input field when pressMode === 'air'; otherwise it's
			// output-1, which uses out-pressure-unit (see updatePressureLabels()).
			const airPressureUnit = pressMode === 'air'
				? (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value
				: (document.getElementById('out-pressure-unit') as HTMLSelectElement).value;
			const triplePoint = roundSig(convert(611.657, 'Pa', airPressureUnit), 6, 1e-6, true);
			errBoilingPoint.textContent = `Air pressure is below water's triple point (${triplePoint} ${airPressureUnit})`;
		}

		const geoAltLbl = document.getElementById('out-geo-alt-label') as HTMLElement;
		geoAltLbl.textContent = useGeopot ? 'Geometric altitude' : 'Geopotential altitude';
		geoAltLbl.dataset.tooltip = useGeopot
			? 'Geometric altitude corresponding to the input geopotential altitude.'
			: 'Geopotential altitude corresponding to the input geometric altitude.';
		const altOther_m = useGeopot ? h_m : atm.geometricToGeopotential(h_m);
		const geoAltUnit = (document.getElementById('out-geo-alt-unit') as HTMLSelectElement).value;
		(document.getElementById('out-geo-alt') as HTMLElement).textContent = roundSig(convert(altOther_m, 'm', geoAltUnit), 6);

		const mdSpecies = (document.getElementById('out-molecular-density-species') as HTMLSelectElement).value;
		const mdUnit    = (document.getElementById('out-molecular-density-unit') as HTMLSelectElement).value;
		const n_total   = atm.getNumberDensity(P_Pa, T_K);
		const mdMoleFraction = mdSpecies === 'total' ? 1 : (atm.getMoleFraction(mdSpecies, h_m) ?? 0);
		(document.getElementById('out-molecular-density') as HTMLElement).textContent = roundSig(convert(mdMoleFraction * n_total, 'per_m3', mdUnit), 6);

		const mfSpecies = (document.getElementById('out-mole-fraction-species') as HTMLSelectElement).value;
		const mf = mfSpecies === 'total' ? 1 : (atm.getMoleFraction(mfSpecies, h_m) ?? 0);
		(document.getElementById('out-mole-fraction') as HTMLElement).textContent = roundSig(mf, 6);

		const mfpUnit = (document.getElementById('out-mfp-unit') as HTMLSelectElement).value;
		(document.getElementById('out-mfp') as HTMLElement).textContent = roundSig(convert(atm.getMeanFreePath(P_Pa, T_K), 'm', mfpUnit), 6);

		(document.getElementById('out-molar-mass') as HTMLElement).textContent = roundSig(atm.getMolarMass(h_m), 6);
	}

	const inputIds = [
		'altitude', 'altitude-unit',
		'sea-level-temp', 'sea-level-temp-unit',
		'sea-level-pressure', 'sea-level-pressure-unit',
		'altitude-mode', 'temp-mode', 'pressure-mode',
		'out-pressure-unit', 'out-press-out-2-unit', 'out-temperature-unit', 'out-density-unit',
		'out-pressure-altitude-unit', 'out-density-altitude-unit', 'out-speed-of-sound-unit', 'out-scale-height-unit',
		'out-viscosity-unit', 'out-boiling-point-unit', 'out-geo-alt-unit',
		'out-mfp-unit', 'out-molecular-density-species', 'out-molecular-density-unit',
		'out-mole-fraction-species',
	];

	for (const id of inputIds) {
		const el = document.getElementById(id)!;
		el.addEventListener('input', calculate);
		el.addEventListener('change', calculate);
	}

	function updateAltitudeLabel() {
		const geo = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const lbl = document.getElementById('lbl-altitude') as HTMLElement;
		lbl.textContent = geo ? 'Geopotential altitude' : 'Geometric altitude';
		lbl.dataset.tooltip = geo
			? 'Altitude scaled for the decrease of gravity with height; used in the standard atmosphere equations.'
			: 'Height above mean sea level along the local vertical.';
	}

	function updateTempLabels() {
		const airMode = (document.getElementById('temp-mode') as HTMLSelectElement).value === 'air';
		const lblIn  = document.getElementById('lbl-temp-input') as HTMLElement;
		const lblOut = document.getElementById('lbl-temp-output') as HTMLElement;
		lblIn.textContent  = airMode ? 'Air temperature' : 'Sea-level temperature';
		lblOut.textContent = airMode ? 'Sea-level temperature' : 'Air temperature';
		lblIn.dataset.tooltip  = airMode
			? 'Temperature at the given altitude; the model back-calculates the sea-level temperature from this.'
			: 'Air temperature at sea level, used as the baseline for the atmospheric temperature profile.';
		lblOut.dataset.tooltip = airMode
			? 'Sea-level temperature back-calculated from the air temperature at altitude.'
			: 'Atmospheric temperature at the given altitude.';
	}

	function updateStdNote() {
		const tempUnit  = (document.getElementById('sea-level-temp-unit')      as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sea-level-pressure-unit')  as HTMLSelectElement).value;
		const tempMode  = (document.getElementById('temp-mode') as HTMLSelectElement).value as 'sea-level' | 'air';
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value as 'sea-level' | 'air' | 'altimeter';
		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const { h_m }   = resolveAltitude(altVal, altUnit, useGeopot);

		const note = getStandardConditionsNote(h_m, tempMode, pressMode, tempUnit, pressUnit);
		if (note !== null) {
			(document.getElementById('std-conditions-note') as HTMLElement).textContent = note;
		}
	}

	const PRESSURE_TOOLTIPS: Record<string, string> = {
		'air_pressure_in':   'Pressure at the given altitude; the model back-calculates the sea-level pressure from this.',
		'altimeter_in':      'Sea-level pressure implied by the station pressure using a standard temperature profile, as set on an aircraft altimeter.',
		'sl_pressure_in':    'Atmospheric pressure at sea level, the starting point for the pressure integration.',
		'air_pressure_out':  'Absolute atmospheric pressure at the given altitude.',
		'sl_pressure_out':   'Station pressure corrected to sea level using the temperature profile; what weather stations report.',
		'altimeter_out':     'Sea-level pressure derived from station pressure using a standard temperature profile; used to calibrate aircraft altimeters.',
	};

	function updatePressureLabels() {
		const mode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		const lblIn   = document.getElementById('lbl-pressure-input') as HTMLElement;
		const lblOut1 = document.getElementById('lbl-press-out-1') as HTMLElement;
		const lblOut2 = document.getElementById('lbl-press-out-2') as HTMLElement;
		lblIn.textContent = mode === 'air' ? 'Air pressure' : mode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
		lblIn.dataset.tooltip = PRESSURE_TOOLTIPS[mode === 'air' ? 'air_pressure_in' : mode === 'altimeter' ? 'altimeter_in' : 'sl_pressure_in'];
		const [out1, out2, tip1, tip2] = mode === 'air'
			? ['Sea-level pressure', 'Altimeter setting', PRESSURE_TOOLTIPS['sl_pressure_out'], PRESSURE_TOOLTIPS['altimeter_out']]
			: mode === 'altimeter'
			? ['Air pressure', 'Sea-level pressure', PRESSURE_TOOLTIPS['air_pressure_out'], PRESSURE_TOOLTIPS['sl_pressure_out']]
			: ['Air pressure', 'Altimeter setting', PRESSURE_TOOLTIPS['air_pressure_out'], PRESSURE_TOOLTIPS['altimeter_out']];
		lblOut1.textContent = out1; lblOut1.dataset.tooltip = tip1;
		lblOut2.textContent = out2; lblOut2.dataset.tooltip = tip2;
	}

	type UnitPreset = { alt: string; temp: string; press: string; dens: string; speed: string; visc: string; mfp: string; };
	const PRESETS: Record<string, UnitPreset> = {
		'default':   { alt: 'm',  temp: 'C', press: 'atm',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-K-Pa':   { alt: 'm',  temp: 'K', press: 'Pa',   dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-C-Pa':   { alt: 'm',  temp: 'C', press: 'Pa',   dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-K-hPa':  { alt: 'm',  temp: 'K', press: 'hPa',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'si-C-hPa':  { alt: 'm',  temp: 'C', press: 'hPa',  dens: 'kg/m3',   speed: 'm/s',  visc: 'Pa·s',        mfp: 'm'  },
		'us-F-atm':  { alt: 'ft', temp: 'F', press: 'atm',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-R-psi':  { alt: 'ft', temp: 'R', press: 'psi',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-F-psi':  { alt: 'ft', temp: 'F', press: 'psi',  dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-R-inHg': { alt: 'ft', temp: 'R', press: 'inHg', dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
		'us-F-inHg': { alt: 'ft', temp: 'F', press: 'inHg', dens: 'lb/ft3',  speed: 'ft/s', visc: 'lbf·s/ft2',  mfp: 'ft' },
	};

	let applyingPreset = false;

	function applyPreset(key: string) {
		const p = PRESETS[key];
		if (!p) return;
		applyingPreset = true;

		// Convert input values to new units
		const altVal  = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const tmpVal  = parseFloat((document.getElementById('sea-level-temp') as HTMLInputElement).value);
		const tmpUnit = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const prVal   = parseFloat((document.getElementById('sea-level-pressure') as HTMLInputElement).value);
		const prUnit  = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;

		if (!isNaN(altVal))
			(document.getElementById('altitude') as HTMLInputElement).value =
				roundSig(convert(convert(altVal, altUnit, 'm'), 'm', p.alt), 6, 1e-6, true);
		if (!isNaN(tmpVal))
			(document.getElementById('sea-level-temp') as HTMLInputElement).value =
				roundSig(convert(convert(tmpVal, tmpUnit, 'K'), 'K', p.temp), 6, 1e-6, true);
		if (!isNaN(prVal))
			(document.getElementById('sea-level-pressure') as HTMLInputElement).value =
				roundSig(convert(convert(prVal, prUnit, 'Pa'), 'Pa', p.press), 6, 1e-6, true);

		// Set all unit selects
		const set = (id: string, v: string) => { (document.getElementById(id) as HTMLSelectElement).value = v; };
		set('altitude-unit',             p.alt);
		set('sea-level-temp-unit',       p.temp);
		set('sea-level-pressure-unit',   p.press);
		set('out-pressure-unit',         p.press);
		set('out-press-out-2-unit',      p.press);
		set('out-temperature-unit',      p.temp);
		set('out-density-unit',          p.dens);
		set('out-pressure-altitude-unit', p.alt);
		set('out-density-altitude-unit', p.alt);
		set('out-speed-of-sound-unit',   p.speed);
		set('out-scale-height-unit',     p.alt);
		set('out-viscosity-unit',        p.visc);
		set('out-boiling-point-unit',      p.temp);
		set('out-geo-alt-unit',            p.alt);
		set('out-mfp-unit',                p.mfp);

		applyingPreset = false;
		updateStdNote();
		calculate();
	}

	// Revert to Custom when user changes any unit dropdown directly
	const unitDropdownIds = [
		'altitude-unit', 'sea-level-temp-unit', 'sea-level-pressure-unit',
		'out-pressure-unit', 'out-press-out-2-unit', 'out-temperature-unit',
		'out-density-unit', 'out-pressure-altitude-unit', 'out-density-altitude-unit',
		'out-speed-of-sound-unit', 'out-scale-height-unit', 'out-viscosity-unit', 'out-boiling-point-unit', 'out-geo-alt-unit',
		'out-mfp-unit', 'out-molecular-density-unit',
	];
	for (const id of unitDropdownIds) {
		document.getElementById(id)!.addEventListener('change', () => {
			if (!applyingPreset)
				(document.getElementById('units-preset') as HTMLSelectElement).value = 'custom';
		});
	}

	document.getElementById('units-preset')!.addEventListener('change', () => {
		const val = (document.getElementById('units-preset') as HTMLSelectElement).value;
		if (val !== 'custom') applyPreset(val);
	});

	document.getElementById('altitude-mode')!.addEventListener('change', updateAltitudeLabel);
	document.getElementById('temp-mode')!.addEventListener('change', () => { updateTempLabels(); calculate(); });
	document.getElementById('pressure-mode')!.addEventListener('change', () => { updatePressureLabels(); calculate(); });
	updateAltitudeLabel();
	updateTempLabels();
	updatePressureLabels();
	updateStdNote();
	calculate();

	document.getElementById('btn-reset')!.addEventListener('click', () => {
		const altVal    = parseFloat((document.getElementById('altitude') as HTMLInputElement).value);
		const altUnit   = (document.getElementById('altitude-unit') as HTMLSelectElement).value;
		const useGeopot = (document.getElementById('altitude-mode') as HTMLSelectElement).value === 'geopotential';
		const tempMode  = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		const pressMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		const tempUnit  = (document.getElementById('sea-level-temp-unit') as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sea-level-pressure-unit') as HTMLSelectElement).value;

		// Leaves altitude untouched — resets only the temperature/pressure inputs to the
		// standard values for the current altitude and mode (matching getStandardConditionsNote):
		// sea-level mode uses the fixed 288.15 K / 101325 Pa; "air" mode uses the standard
		// value at the current altitude; altimeter setting is always the fixed sea-level value
		// by definition, regardless of altitude.
		const { h_m } = resolveAltitude(altVal, altUnit, useGeopot);

		const stdT_K = tempMode === 'air' ? atm.getTemperature(h_m) : 288.15;
		if (!isNaN(stdT_K)) {
			(document.getElementById('sea-level-temp') as HTMLInputElement).value =
				roundSig(convert(stdT_K, 'K', tempUnit), 6, 1e-6, true, tempUnit);
		}

		const stdP_Pa = pressMode === 'air' ? atm.getStandardPressure(h_m) : 101325;
		if (!isNaN(stdP_Pa)) {
			(document.getElementById('sea-level-pressure') as HTMLInputElement).value =
				roundSig(convert(stdP_Pa, 'Pa', pressUnit), 6, 1e-6, true);
		}

		calculate();
	});
</script>
