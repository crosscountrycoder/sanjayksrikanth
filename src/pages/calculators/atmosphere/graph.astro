---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AtmosphereNav from '../../../components/AtmosphereNav.astro';
---

<Layout title="Graph | Standard Atmosphere Calculator">
	<Breadcrumb crumbs={[
		{ label: 'Home', href: '/' },
		{ label: 'Calculators', href: '/calculators' },
		{ label: 'Standard Atmosphere Calculator' },
	]} />
	<h1>Standard Atmosphere Calculator</h1>
	<AtmosphereNav active="graph" />
	<p>Graph atmospheric properties as a function of altitude using a version of
		the <a href="https://en.wikipedia.org/wiki/U.S._Standard_Atmosphere" target="_blank">U.S. Standard Atmosphere 1976 model</a>.</p>

	<section class="graph-page">
		<div class="controls">
			<h2>Settings</h2>

			<h3>Conditions</h3>
			<div class="field">
				<label for="cond-alt">Altitude</label>
				<div class="input-row">
					<input type="number" id="cond-alt" value="0" />
					<select id="cond-alt-unit">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-cond-alt"></p>
			<div class="field">
				<label for="sl-temp" id="lbl-sl-temp">Sea-level temperature</label>
				<div class="input-row">
					<input type="number" id="sl-temp" value="15" />
					<select id="sl-temp-unit">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-sl-temp"></p>
			<div class="field">
				<label for="sl-pressure" id="lbl-sl-pressure">Sea-level pressure</label>
				<div class="input-row">
					<input type="number" id="sl-pressure" value="1" />
					<select id="sl-pressure-unit">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-sl-pressure"></p>
			<div class="reset-row">
				<button id="btn-reset">Reset to standard conditions</button>
			</div>

			<h3>Input settings</h3>
			<div class="field">
				<label for="x-var">Altitude</label>
				<select id="x-var">
					<option value="geometric" selected>Geometric</option>
					<option value="geopotential">Geopotential</option>
				</select>
			</div>
			<div class="field">
				<label for="temp-mode">Temperature</label>
				<select id="temp-mode">
					<option value="sea-level" selected>Sea-level temperature</option>
					<option value="air">Air temperature</option>
				</select>
			</div>
			<div class="field">
				<label for="pressure-mode">Pressure</label>
				<select id="pressure-mode">
					<option value="sea-level" selected>Sea-level pressure</option>
					<option value="air">Air pressure</option>
					<option value="altimeter">Altimeter setting</option>
				</select>
			</div>

			<h3>Altitude</h3>
			<div class="field">
				<label>Range</label>
				<div class="range-row">
					<input type="number" id="x-min" value="0" />
					<span>–</span>
					<input type="number" id="x-max" value="10000" />
					<select id="x-unit">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
			</div>
			<p class="error" id="err-x-range"></p>
			<div class="field">
				<label for="x-intervals">Intervals</label>
				<input type="number" id="x-intervals" value="5" min="1" step="1" />
			</div>
			<div class="checkbox-row">
				<input type="checkbox" id="alt-on-y" />
				<label for="alt-on-y">Altitude on y-axis</label>
			</div>
			<p class="hint">With 2+ variables selected below, altitude is always on the y-axis.</p>

			<h3>Dependent variables</h3>
			<p class="hint">Each variable has its own range (defaults to auto) and, except for temperature quantities, its own logarithmic-scale option. The interval count below always applies to every variable's axis alike.</p>
			<div class="field">
				<label for="y-intervals">Intervals</label>
				<input type="number" id="y-intervals" value="5" min="1" step="1" />
			</div>
			<div class="var-list" id="var-list">
				<div class="var-row">
					<input type="checkbox" id="chk-pressure" data-var="pressure" checked />
					<label for="chk-pressure">Air pressure</label>
					<select id="unit-pressure">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-pressure" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-pressure" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-pressure" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-altimeter_setting" data-var="altimeter_setting" />
					<label for="chk-altimeter_setting">Altimeter setting</label>
					<select id="unit-altimeter_setting">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-altimeter_setting" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-altimeter_setting" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-altimeter_setting" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-sea_level_pressure" data-var="sea_level_pressure" />
					<label for="chk-sea_level_pressure">Sea-level pressure</label>
					<select id="unit-sea_level_pressure">
						<option value="atm" selected>atm</option>
						<option value="Pa">Pa</option>
						<option value="hPa">hPa (mbar)</option>
						<option value="kPa">kPa</option>
						<option value="mmHg">mmHg (Torr)</option>
						<option value="inHg">inHg</option>
						<option value="psi">psi</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-sea_level_pressure" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-sea_level_pressure" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-sea_level_pressure" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-temperature" data-var="temperature" />
					<label for="chk-temperature">Air temperature</label>
					<select id="unit-temperature">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-temperature" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-temperature" placeholder="auto" />
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-density" data-var="density" />
					<label for="chk-density">Air density</label>
					<select id="unit-density">
						<option value="kg/m3" selected>kg/m³</option>
						<option value="lb/ft3">lb/ft³</option>
						<option value="slug/ft3">slug/ft³</option>
						<option value="sigma">sigma (SL std=1)</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-density" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-density" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-density" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-pressure_altitude" data-var="pressure_altitude" />
					<label for="chk-pressure_altitude">Pressure altitude</label>
					<select id="unit-pressure_altitude">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-pressure_altitude" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-pressure_altitude" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-pressure_altitude" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-density_altitude" data-var="density_altitude" />
					<label for="chk-density_altitude">Density altitude</label>
					<select id="unit-density_altitude">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-density_altitude" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-density_altitude" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-density_altitude" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-geopotential_alt" data-var="geopotential_alt" />
					<label for="chk-geopotential_alt">Geopotential altitude</label>
					<select id="unit-geopotential_alt">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-geopotential_alt" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-geopotential_alt" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-geopotential_alt" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-geometric_alt" data-var="geometric_alt" />
					<label for="chk-geometric_alt">Geometric altitude</label>
					<select id="unit-geometric_alt">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-geometric_alt" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-geometric_alt" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-geometric_alt" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-molar_mass" data-var="molar_mass" />
					<label for="chk-molar_mass">Molar mass</label>
					<select id="unit-molar_mass">
						<option value="g/mol" selected>g/mol</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-molar_mass" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-molar_mass" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-molar_mass" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-speed_of_sound" data-var="speed_of_sound" />
					<label for="chk-speed_of_sound">Speed of sound</label>
					<select id="unit-speed_of_sound">
						<option value="m/s" selected>m/s</option>
						<option value="km/h">km/h</option>
						<option value="mph">mph</option>
						<option value="ft/s">ft/s</option>
						<option value="kn">knots</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-speed_of_sound" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-speed_of_sound" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-speed_of_sound" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-viscosity" data-var="viscosity" />
					<label for="chk-viscosity">Dynamic viscosity</label>
					<select id="unit-viscosity">
						<option value="Pa·s" selected>Pa·s</option>
						<option value="μPa·s">μPa·s</option>
						<option value="mPa·s">mPa·s (centipoise)</option>
						<option value="lbf·s/ft2">lbf·s/ft²</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-viscosity" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-viscosity" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-viscosity" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-mean_free_path" data-var="mean_free_path" />
					<label for="chk-mean_free_path">Mean free path</label>
					<select id="unit-mean_free_path">
						<option value="nm">nm</option>
						<option value="μm">μm</option>
						<option value="mm">mm</option>
						<option value="m" selected>m</option>
						<option value="km">km</option>
						<option value="in">in</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-mean_free_path" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-mean_free_path" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-mean_free_path" /> log</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-scale_height" data-var="scale_height" />
					<label for="chk-scale_height">Scale height</label>
					<select id="unit-scale_height">
						<option value="m" selected>m</option>
						<option value="ft">ft</option>
						<option value="mi">mi</option>
						<option value="km">km</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-scale_height" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-scale_height" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-scale_height" /> log</label>
				</div>
				<div class="var-row pp-header">
					<span class="pp-label">Number density</span>
					<select id="unit-molecular_density">
						<option value="per_m3" selected>/m³</option>
						<option value="per_L">/L</option>
						<option value="per_ft3">/ft³</option>
						<option value="mol_m3">mol/m³</option>
						<option value="kmol_m3">kmol/m³ (mol/L)</option>
						<option value="lbmol_ft3">lbmol/ft³</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-molecular_density" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-molecular_density" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-molecular_density" /> log</label>
				</div>
				<div class="pp-species">
					<label><input type="checkbox" data-var="molecular_density" data-species="total"> Total</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N2"> N₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="O2"> O₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Ar"> Ar</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="CO2"> CO₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Ne"> Ne</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="He"> He</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="CH4"> CH₄</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Kr"> Kr</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="H2"> H₂</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N2O"> N₂O</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="Xe"> Xe</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="O"> O</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="H"> H</label>
					<label><input type="checkbox" data-var="molecular_density" data-species="N"> N</label>
				</div>
				<div class="var-row pp-header">
					<span class="pp-label">Mole fraction</span>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-mole_fraction" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-mole_fraction" placeholder="auto" />
					<label class="log-label"><input type="checkbox" id="log-mole_fraction" /> log</label>
				</div>
				<div class="pp-species">
					<label><input type="checkbox" data-var="mole_fraction" data-species="total"> Total</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N2"> N₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="O2"> O₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Ar"> Ar</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="CO2"> CO₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Ne"> Ne</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="He"> He</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="CH4"> CH₄</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Kr"> Kr</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="H2"> H₂</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N2O"> N₂O</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="Xe"> Xe</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="O"> O</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="H"> H</label>
					<label><input type="checkbox" data-var="mole_fraction" data-species="N"> N</label>
				</div>
				<div class="var-row">
					<input type="checkbox" id="chk-boiling_point" data-var="boiling_point" />
					<label for="chk-boiling_point">Boiling point of water</label>
					<select id="unit-boiling_point">
						<option value="C" selected>°C</option>
						<option value="F">°F</option>
						<option value="K">K</option>
						<option value="R">°R</option>
					</select>
				</div>
				<div class="var-range-row">
					<input type="number" id="min-boiling_point" placeholder="auto" />
					<span>–</span>
					<input type="number" id="max-boiling_point" placeholder="auto" />
				</div>
			</div>
			<p class="error" id="err-var-count"></p>
			<p class="error" id="err-y-log"></p>
		</div>

		<div class="graph-area">
			<svg id="graph-svg" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg"></svg>
			<div class="graph-actions">
				<button id="btn-download">Download SVG</button>
			</div>
		</div>
	</section>
</Layout>

<style>
	.graph-page {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1.5rem;
		align-items: start;
	}

.error {
		color: red;
		font-size: 0.875rem;
		margin: 0 0 0.4rem;
	}

	.field {
		display: grid;
		grid-template-columns: 6rem 1fr;
		align-items: center;
		column-gap: 0.5rem;
		margin-bottom: 0.4rem;
	}

	input[type="number"] {
		flex: 1;
		min-width: 0;
		max-width: 6rem;
	}

	select {
		width: 100%;
	}

	.input-row select,
	.range-row select {
		width: auto;
	}

	.range-row input[type="number"] {
		max-width: 4rem;
	}

	.checkbox-row {
		margin-bottom: 0.4rem;
	}

	.hint {
		font-size: 0.8125rem;
		color: var(--color-text);
		opacity: 0.7;
		margin: 0 0 0.4rem;
	}

	.var-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-height: 24rem;
		overflow-y: auto;
		border: 1px solid var(--color-border);
		border-radius: 0;
		padding: 0.4rem 0.5rem;
		margin-bottom: 0.5rem;
	}

	.var-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.var-row input[type="checkbox"] {
		flex-shrink: 0;
	}

	.var-row label {
		flex: 1;
		min-width: 0;
		font-size: 0.9375rem;
	}

	.var-row select {
		width: auto;
		flex-shrink: 0;
		font-size: 0.9375rem;
		padding: 0.15rem 0.25rem;
	}

	.pp-header .pp-label {
		flex: 1;
		font-size: 0.9375rem;
	}

	.pp-species {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: 0.1rem 0.6rem;
		padding: 0.1rem 0 0.2rem 1.25rem;
		font-size: 0.9375rem;
	}

	.pp-species label {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		cursor: pointer;
	}

	.var-range-row {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0 0 0.3rem 1.4rem;
		font-size: 0.8125rem;
	}

	.var-range-row input[type="number"] {
		max-width: 3.4rem;
		min-width: 0;
	}

	.var-range-row .log-label {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		margin-left: 0.3rem;
		white-space: nowrap;
		cursor: pointer;
	}

	.graph-area {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	#graph-svg {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 0;
	}

	.graph-actions button {
		font-size: 1rem;
	}

	@media (max-width: 700px) {
		.graph-page {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import * as atm  from '../../../lib/atmosphere.ts';
	import { getBoilingPoint } from '../../../lib/water-properties.ts';
	import * as atmg from '../../../lib/atmosphere-graph.ts';
	import { convert } from '../../../lib/convert.ts';
	import { roundSig } from '../../../lib/helpers.ts';

	const AIR_TEMP_MAX_GEOPOT = 20000; // m — above this, air temperature no longer depends on sea-level temp, so "Air temperature" input mode is unavailable

	// Geopotential-altitude equivalents of the model's geometric range (-5000 to 1000000 m),
	// computed rather than hardcoded so bound-check messages round to the true value.
	const GEOPOT_MIN = atm.geometricToGeopotential(-5000);
	const GEOPOT_MAX = atm.geometricToGeopotential(1000000);

	// Above 20 km geopotential, sea-level temp has no effect on air temp at all, so back-solving
	// sea-level temp from an entered air temp is meaningless there — disable the "Air temperature"
	// option and fall back to "Sea-level temperature" mode if it was selected.
	function syncTempModeAvailability() {
		const tempModeSel = document.getElementById('temp-mode') as HTMLSelectElement;
		const airOption   = tempModeSel.querySelector('option[value="air"]') as HTMLOptionElement;
		const condAltVal  = parseFloat((document.getElementById('cond-alt') as HTMLInputElement).value);
		const condAltUnit = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const xVar        = (document.getElementById('x-var') as HTMLSelectElement).value;

		if (isNaN(condAltVal)) {
			airOption.disabled = false;
			return;
		}
		const condAlt_m = convert(condAltVal, condAltUnit, 'm');
		const H_cond = xVar === 'geopotential' ? condAlt_m : atm.geometricToGeopotential(condAlt_m);
		const aboveLimit = H_cond > AIR_TEMP_MAX_GEOPOT;
		airOption.disabled = aboveLimit;
		if (aboveLimit && tempModeSel.value === 'air') {
			tempModeSel.value = 'sea-level';
			updateConditionLabels();
		}
	}

	// Tick helpers
	function linearTicks(min: number, max: number, n: number): number[] {
		const ticks: number[] = [];
		for (let i = 0; i <= n; i++)
			ticks.push(parseFloat((min + (max - min) * i / n).toPrecision(10)));
		return ticks;
	}
	// Returns n+1 ticks evenly spaced in log10 space between lo and hi (both must be > 0).
	function logTicks(lo: number, hi: number, n: number): number[] {
		const logLo = Math.log10(lo), logHi = Math.log10(hi);
		const ticks: number[] = [];
		for (let i = 0; i <= n; i++)
			ticks.push(Math.pow(10, logLo + (logHi - logLo) * i / n));
		return ticks;
	}
	// Strips trailing zeros from a rounded number's string without reverting the notation
	// roundSig chose — unlike roundSig's own stripTrailingZeros (which round-trips through
	// Number(...).toString() and would flatten a large exponential value back to plain).
	function stripZerosKeepNotation(s: string): string {
		const eIdx = s.indexOf('e');
		const mantissa = eIdx === -1 ? s : s.slice(0, eIdx);
		const suffix = eIdx === -1 ? '' : s.slice(eIdx);
		const trimmed = mantissa.includes('.') ? mantissa.replace(/0+$/, '').replace(/\.$/, '') : mantissa;
		return trimmed + suffix;
	}

	// Axis tick label: 4 sig figs, scientific notation below 1e-3. Non-altitude quantities
	// keep roundSig's native upper threshold (exponential once the value needs more than 4
	// digits before the decimal point), with trailing zeros stripped without disturbing that
	// notation. Altitude ticks instead use whichever of "4 significant figures" or "nearest
	// integer" is closer to the true value — 4 sig figs alone would round 699995 to 700000,
	// but the nearest integer (699995 itself) is far more precise for large altitude values,
	// where this model's own range (up to 1,000,000 m) routinely needs more than 4 digits.
	function formatTick(v: number, isAltitude: boolean): string {
		if (v === 0) return '0';
		if (!isAltitude) return stripZerosKeepNotation(roundSig(v, 4, 1e-3));
		if (Math.abs(v) < 1e-3) return roundSig(v, 4, 1e-3, true);
		const sigFigVal = Number(v.toPrecision(4));
		const intVal = Math.round(v);
		const chosen = Math.abs(v - intVal) < Math.abs(v - sigFigVal) ? intVal : sigFigVal;
		return chosen.toString();
	}

	const MAX_VARS = 6;

	const SPECIES_DISPLAY: Record<string, string> = {
		total: 'Total',
		N2: 'N₂', O2: 'O₂', Ar: 'Ar', CO2: 'CO₂',
		Ne: 'Ne', He: 'He', CH4: 'CH₄', Kr: 'Kr', H2: 'H₂', N2O: 'N₂O', Xe: 'Xe',
		O: 'O', H: 'H', N: 'N',
	};

	const Y_LABELS: Record<string, string> = {
		pressure:          'Air pressure',
		altimeter_setting: 'Altimeter setting',
		sea_level_pressure:'Sea-level pressure',
		temperature:       'Air temperature',
		density:           'Air density',
		pressure_altitude: 'Pressure altitude',
		density_altitude:  'Density altitude',
		speed_of_sound:    'Speed of sound',
		scale_height:      'Scale height',
		viscosity:         'Dynamic viscosity',
		boiling_point:     'Boiling point of water',
		geopotential_alt:  'Geopotential altitude',
		geometric_alt:     'Geometric altitude',
		mean_free_path:    'Mean free path',
		molar_mass:        'Molar mass',
		molecular_density: 'Number density',
		mole_fraction:     'Mole fraction',
	};

	// Quantities that are themselves a length/altitude, so their tick labels get the
	// same "4 sig figs vs. nearest integer" treatment as the altitude axis.
	const ALTITUDE_LIKE_KEYS = new Set([
		'pressure_altitude', 'density_altitude', 'geopotential_alt', 'geometric_alt',
	]);

	// Per-series line/axis colors when 2+ variables are plotted together.
	const LINE_COLORS = ['#0000ff', '#ff0000', '#00e000', '#e0e000', '#00e0e0', '#ff00ff'];

	interface VarConfig {
		key: string;
		unit: string;
		unitLabel: string;
		species: string;
		label: string;
		yMin: number | null;
		yMax: number | null;
		logScale: boolean;
	}

	// Only variable checkboxes carry data-var; the per-variable "log" checkboxes added
	// alongside them do not, so this selector (unlike a bare :checked) never counts them.
	function getCheckedVars(): VarConfig[] {
		return Array.from(
			document.querySelectorAll<HTMLInputElement>('#var-list input[type=checkbox][data-var]:checked')
		).map(chk => {
			const key = chk.dataset.var!;
			const unitSel = document.getElementById(`unit-${key}`) as HTMLSelectElement | null;
			const unit = unitSel?.value ?? '';
			const unitLabel = unitSel ? unitSel.options[unitSel.selectedIndex].text : '';
			const species = chk.dataset.species ?? '';
			const label = key === 'mole_fraction'
				? `Mole fraction ${SPECIES_DISPLAY[species]}`
				: key === 'molecular_density'
				? `Number density (${unitLabel}) ${SPECIES_DISPLAY[species]}`
				: `${Y_LABELS[key]} (${unitLabel})`;

			const minEl = document.getElementById(`min-${key}`) as HTMLInputElement | null;
			const maxEl = document.getElementById(`max-${key}`) as HTMLInputElement | null;
			const logEl = document.getElementById(`log-${key}`) as HTMLInputElement | null;
			const minVal = minEl && minEl.value !== '' ? parseFloat(minEl.value) : NaN;
			const maxVal = maxEl && maxEl.value !== '' ? parseFloat(maxEl.value) : NaN;
			const yMin = isNaN(minVal) ? null : minVal;
			const yMax = isNaN(maxVal) ? null : maxVal;
			// Temperature and boiling point have no log checkbox in the markup (log scale
			// doesn't suit a quantity that can be zero or negative depending on unit), so
			// logEl is null for them and logScale is always false.
			const logScale = logEl?.checked ?? false;

			return { key, unit, unitLabel, species, label, yMin, yMax, logScale };
		});
	}

	function updateModeUI() {
		const vars  = getCheckedVars();
		const multi = vars.length >= 2;
		const altOnYEl = document.getElementById('alt-on-y') as HTMLInputElement;
		altOnYEl.disabled = multi;
		if (multi) altOnYEl.checked = true;
	}

	function graphColors() {
		const dark = document.documentElement.dataset.theme === 'dark';
		return {
			bg:      dark ? '#000000' : '#ffffff',
			plotBg:  dark ? '#111111' : '#f8f8f8',
			grid:    dark ? '#333333' : '#e0e0e0',
			axis:    dark ? '#cccccc' : '#333333',
			text:    dark ? '#cccccc' : '#333333',
			line:    '#0000ff',
		};
	}

	// Computes one variable's value at a single altitude's physical state.
	function computeVarValue(v: VarConfig, ctx: {
		P_Pa: number; T_K: number; rho: number; H: number; h_m: number; T0_K: number;
	}): number | null {
		const { P_Pa, T_K, rho, H, h_m, T0_K } = ctx;
		switch (v.key) {
			case 'pressure':           return convert(P_Pa, 'Pa', v.unit);
			case 'altimeter_setting':  return convert(atm.getAltimeterSetting(h_m, P_Pa), 'Pa', v.unit);
			case 'sea_level_pressure': return convert(atm.getSeaLevelPressure(h_m, P_Pa, T0_K), 'Pa', v.unit);
			case 'temperature':        return convert(T_K, 'K', v.unit);
			case 'density':            return convert(rho, 'kg/m3', v.unit);
			case 'pressure_altitude': {
				const pa = atm.getPressureAltitude(P_Pa);
				return isNaN(pa) ? null : convert(pa, 'm', v.unit);
			}
			case 'density_altitude': {
				const da = atm.getDensityAltitude(rho);
				return isNaN(da) ? null : convert(da, 'm', v.unit);
			}
			case 'speed_of_sound':     return convert(atm.getSpeedOfSound(T_K, atm.getMolarMass(h_m)), 'm/s', v.unit);
			case 'scale_height':       return convert(atm.getScaleHeight(T_K, atm.getMolarMass(h_m), h_m), 'm', v.unit);
			case 'viscosity':          return convert(atm.getViscosity(T_K), 'Pa·s', v.unit);
			case 'boiling_point':      return P_Pa >= 611.657 ? convert(getBoilingPoint(P_Pa), 'K', v.unit) : null;
			case 'geopotential_alt':   return convert(H, 'm', v.unit);
			case 'geometric_alt':      return convert(h_m, 'm', v.unit);
			case 'molecular_density': {
				const n_total = atm.getNumberDensity(P_Pa, T_K);
				const mf = v.species === 'total' ? 1 : (atm.getMoleFraction(v.species, h_m) ?? 0);
				return convert(mf * n_total, 'per_m3', v.unit);
			}
			case 'mole_fraction':
				return v.species === 'total' ? 1 : (atm.getMoleFraction(v.species, h_m) ?? 0);
			case 'mean_free_path':     return convert(atm.getMeanFreePath(P_Pa, T_K), 'm', v.unit);
			case 'molar_mass':         return atm.getMolarMass(h_m);
			default: return null;
		}
	}

	// Tick label for a variable's own axis: temperature/boiling-point use roundSig (to
	// avoid e.g. "-0°C"), altitude-like quantities get integer-vs-4-sig-fig treatment,
	// everything else uses formatTick's general rule.
	function tickLabelFor(v: VarConfig, value: number): string {
		if (v.key === 'temperature' || v.key === 'boiling_point')
			return roundSig(value, 4, 1e-3, false, v.unit);
		return formatTick(value, ALTITUDE_LIKE_KEYS.has(v.key));
	}

	function generateGraph() {
		syncTempModeAvailability();

		const C = graphColors();
		const svgEl = document.getElementById('graph-svg') as unknown as SVGSVGElement;
		const condAltVal  = parseFloat((document.getElementById('cond-alt') as HTMLInputElement).value);
		const condAltUnit = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const slTempVal   = parseFloat((document.getElementById('sl-temp') as HTMLInputElement).value);
		const slTempUnit  = (document.getElementById('sl-temp-unit') as HTMLSelectElement).value;
		const slPressVal  = parseFloat((document.getElementById('sl-pressure') as HTMLInputElement).value);
		const slPressUnit = (document.getElementById('sl-pressure-unit') as HTMLSelectElement).value;
		const xVar        = (document.getElementById('x-var') as HTMLSelectElement).value;
		const tempMode    = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		const pressMode   = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		const xUnit       = (document.getElementById('x-unit') as HTMLSelectElement).value;
		const xMin        = parseFloat((document.getElementById('x-min') as HTMLInputElement).value);
		const xMax        = parseFloat((document.getElementById('x-max') as HTMLInputElement).value);
		const xIntervals  = parseInt((document.getElementById('x-intervals') as HTMLInputElement).value) || 5;
		const yIntervals  = parseInt((document.getElementById('y-intervals') as HTMLInputElement).value) || 5;
		const vars        = getCheckedVars().slice(0, MAX_VARS);
		const multi       = vars.length >= 2;
		const altOnY      = multi || (document.getElementById('alt-on-y') as HTMLInputElement).checked;

		const errCondAlt    = document.getElementById('err-cond-alt') as HTMLElement;
		const errSlTemp     = document.getElementById('err-sl-temp') as HTMLElement;
		const errSlPressure = document.getElementById('err-sl-pressure') as HTMLElement;
		const errXRange     = document.getElementById('err-x-range') as HTMLElement;
		const errYLog       = document.getElementById('err-y-log') as HTMLElement;
		errCondAlt.textContent = '';
		errSlTemp.textContent = '';
		errSlPressure.textContent = '';
		errXRange.textContent = '';
		errYLog.textContent = '';

		if (vars.length === 0) { svgEl.innerHTML = ''; return; }
		if ([condAltVal, slTempVal, slPressVal, xMin, xMax].some(isNaN) || xMin >= xMax) { svgEl.innerHTML = ''; return; }

		// Conditions altitude → geopotential
		const condAlt_m = convert(condAltVal, condAltUnit, 'm');
		const H_cond = xVar === 'geopotential' ? condAlt_m : atm.geometricToGeopotential(condAlt_m);
		const loH = xVar === 'geopotential' ? GEOPOT_MIN : -5000;
		const hiH = xVar === 'geopotential' ? GEOPOT_MAX : 1000000;
		if (condAlt_m < loH || condAlt_m > hiH) {
			const factor = convert(1, 'm', condAltUnit);
			const label = xVar === 'geopotential' ? 'Geopotential altitude' : 'Geometric altitude';
			errCondAlt.textContent = `${label} must be between ${roundSig(loH * factor, 6, 1e-6, true)} and ${roundSig(hiH * factor, 6, 1e-6, true)} ${condAltUnit}`;
			svgEl.innerHTML = ''; return;
		}

		// Derive T0_K from temp mode
		const T_input_K = convert(slTempVal, slTempUnit, 'K');
		const z_cond = xVar === 'geopotential' ? atm.geopotentialToGeometric(condAlt_m) : condAlt_m;
		const T0_K = tempMode === 'air' ? atm.getSeaLevelTemperature(z_cond, T_input_K) : T_input_K;
		const loK = atm.SEA_LEVEL_TEMP_MIN_K, hiK = atm.SEA_LEVEL_TEMP_MAX_K;
		if (isNaN(T0_K) || T0_K < loK || T0_K > hiK) {
			const unitLabel: Record<string, string> = { C: '°C', F: '°F', K: 'K', R: '°R' };
			if (tempMode === 'air') {
				const fmtT = (K: number) => parseFloat(convert(K, 'K', slTempUnit).toFixed(3)).toString();
				const xK = atm.getTemperature(z_cond, hiK);
				errSlTemp.textContent = `Temperature at this altitude must be between ${fmtT(loK)} and ${fmtT(xK)} ${unitLabel[slTempUnit]}.`;
			} else {
				const fmt = (K: number) => roundSig(convert(K, 'K', slTempUnit), 6, 1e-6, true);
				const lo = fmt(loK), hi = fmt(hiK);
				errSlTemp.textContent = `Sea-level temperature must be between ${lo} and ${hi} ${unitLabel[slTempUnit]}.`;
			}
			svgEl.innerHTML = ''; return;
		}

		// Derive P0_Pa from pressure mode
		const P_input_Pa = convert(slPressVal, slPressUnit, 'Pa');
		let P0_Pa: number;
		if (pressMode === 'sea-level') {
			P0_Pa = P_input_Pa;
		} else if (pressMode === 'air') {
			P0_Pa = atm.getSeaLevelPressure(z_cond, P_input_Pa, T0_K);
		} else { // altimeter
			const P_at_cond = P_input_Pa * atm.getPressure(z_cond, 1, 288.15);
			P0_Pa = atm.getSeaLevelPressure(z_cond, P_at_cond, T0_K);
		}
		if (P_input_Pa <= 0) {
			const label = pressMode === 'air' ? 'Air pressure' : pressMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
			errSlPressure.textContent = `${label} must be greater than 0 ${slPressUnit}.`;
			svgEl.innerHTML = ''; return;
		}

		const xMin_m = convert(xMin, xUnit, 'm');
		const xMax_m = convert(xMax, xUnit, 'm');
		const loX = xVar === 'geopotential' ? GEOPOT_MIN : -5000;
		const hiX = xVar === 'geopotential' ? GEOPOT_MAX : 1000000;
		if (xMin_m < loX || xMax_m > hiX) {
			const factor = convert(1, 'm', xUnit);
			const lo = roundSig(loX * factor, 6, 1e-6, true);
			const hi = roundSig(hiX * factor, 6, 1e-6, true);
			errXRange.textContent = `Altitude range must be between ${lo} and ${hi} ${xUnit}.`;
			svgEl.innerHTML = ''; return;
		}

		// Geometric altitude extent of the graph
		const h_min = xVar === 'geometric' ? xMin_m : atm.geopotentialToGeometric(xMin_m);
		const h_max = xVar === 'geometric' ? xMax_m : atm.geopotentialToGeometric(xMax_m);

		// Build 50 m geometric grid and integrate the atmosphere in one pass.
		const geoZ    = atmg.buildGraphAltitudes(h_min, h_max);
		const profZ   = geoZ.filter(z => z >= -5000);
		const profOff = geoZ.length - profZ.length; // # of sub-(-5000) points at the start
		const prof    = atm.buildAtmosphereProfile(profZ, P0_Pa, T0_K);
		const rhoArr  = atmg.profileDensity(prof);

		const xVals: number[] = [];
		const series: (number | null)[][] = vars.map(() => []);

		for (let i = 0; i < geoZ.length; i++) {
			const h_m  = geoZ[i];
			const H    = atm.geometricToGeopotential(h_m);
			const xVal = i === 0 ? xMin
				: i === geoZ.length - 1 ? xMax
				: xVar === 'geometric' ? convert(h_m, 'm', xUnit) : convert(H, 'm', xUnit);
			xVals.push(xVal);

			if (h_m < -5000) { vars.forEach((_, vi) => series[vi].push(null)); continue; }

			const pi   = i - profOff;
			const ctx  = { P_Pa: prof.P[pi], T_K: prof.T[pi], rho: rhoArr[pi], H, h_m, T0_K };
			vars.forEach((v, vi) => series[vi].push(computeVarValue(v, ctx)));
		}

		if (!multi) {
			renderSingle(svgEl, C, vars[0], xVals, series[0],
				{ xVar, xUnit, xMin, xMax, xIntervals, yIntervals, altOnY, errYLog });
		} else {
			renderMulti(svgEl, C, vars, xVals, series, { xVar, xUnit, xMin, xMax, xIntervals, yIntervals });
		}
	}

	// ── Single-variable render: full real axis, range override, log scale, orientation toggle ──
	function renderSingle(
		svgEl: SVGSVGElement, C: ReturnType<typeof graphColors>, v: VarConfig,
		xVals: number[], yVals: (number | null)[],
		opts: {
			xVar: string; xUnit: string; xMin: number; xMax: number; xIntervals: number;
			yIntervals: number; altOnY: boolean; errYLog: HTMLElement;
		},
	) {
		const { xVar, xUnit, xMin, xMax, xIntervals, yIntervals, altOnY, errYLog } = opts;
		const yMinUser = v.yMin, yMaxUser = v.yMax, yLog = v.logScale;
		const pts = xVals.map((x, i) => ({ x, y: yVals[i] }));
		const validY = pts.filter(p => p.y !== null).map(p => p.y as number);
		if (validY.length < 2) { svgEl.innerHTML = ''; return; }
		const yDataMin = Math.min(...validY), yDataMax = Math.max(...validY);
		if (yDataMin === yDataMax) { svgEl.innerHTML = ''; return; }

		const W = 600, HS = 400;
		svgEl.setAttribute('viewBox', `0 0 ${W} ${HS}`);

		let yLo: number, yHi: number, yTicks: number[], my: (val: number) => number;

		if (yLog) {
			const posY = validY.filter(x => x > 0);
			if (posY.length < 2) {
				errYLog.textContent = 'Logarithmic scale requires all y-values to be positive.';
				svgEl.innerHTML = ''; return;
			}
			const logDataMin = Math.min(...posY), logDataMax = Math.max(...posY);
			yLo = yMinUser !== null && yMinUser > 0 ? yMinUser : logDataMin;
			yHi = yMaxUser !== null && yMaxUser > 0 ? yMaxUser : logDataMax;
			if (yMinUser !== null && yMinUser <= 0) {
				errYLog.textContent = 'Y-axis minimum must be positive for logarithmic scale.';
				svgEl.innerHTML = ''; return;
			}
			if (yLo >= yHi) { svgEl.innerHTML = ''; return; }
			yTicks = logTicks(yLo, yHi, yIntervals);
			const logLo = Math.log10(yLo), logHi = Math.log10(yHi);
			const pL = 62, pR = W - 20, pT = 35, pB = HS - 50;
			const pW = pR - pL, pH = pB - pT;
			const xTicks = linearTicks(xMin, xMax, xIntervals);

			// log scale maps the variable axis; altitude axis is always linear
			const mxLog = altOnY
				? (val: number) => val > 0 ? pL + (Math.log10(val) - logLo) / (logHi - logLo) * pW : pL - 999
				: (val: number) => pL + (val - xMin) / (xMax - xMin) * pW;
			const myLog = altOnY
				? (val: number) => pB - (val - xMin) / (xMax - xMin) * pH
				: (val: number) => val > 0 ? pB - (Math.log10(val) - logLo) / (logHi - logLo) * pH : pB + 999;
			my = myLog;

			const horzTicks = altOnY ? yTicks  : xTicks;
			const vertTicks = altOnY ? xTicks  : yTicks;

			const altLabel = `${xVar === 'geometric' ? 'Geometric' : 'Geopotential'} altitude (${xUnit})`;
			const xLabel = altOnY ? v.label : altLabel;
			const yLabel = altOnY ? altLabel : v.label;

			let s = '';
			s += `<rect width="${W}" height="${HS}" fill="${C.bg}"/>`;
			s += `<rect x="${pL}" y="${pT}" width="${pW}" height="${pH}" fill="${C.plotBg}"/>`;
			s += `<defs><clipPath id="c"><rect x="${pL}" y="${pT}" width="${pW}" height="${pH}"/></clipPath></defs>`;

			for (const ht of horzTicks) {
				const x = mxLog(ht).toFixed(1);
				s += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pB}" stroke="${C.grid}" stroke-width="1"/>`;
			}
			for (const vt of vertTicks) {
				const y = myLog(vt).toFixed(1);
				s += `<line x1="${pL}" y1="${y}" x2="${pR}" y2="${y}" stroke="${C.grid}" stroke-width="1"/>`;
			}

			s += `<line x1="${pL}" y1="${pT}" x2="${pL}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;
			s += `<line x1="${pL}" y1="${pB}" x2="${pR}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;

			for (const ht of horzTicks) {
				const x = mxLog(ht).toFixed(1);
				s += `<line x1="${x}" y1="${pB}" x2="${x}" y2="${pB + 5}" stroke="${C.axis}" stroke-width="1"/>`;
				const lbl = altOnY ? tickLabelFor(v, ht) : formatTick(ht, true);
				s += `<text x="${x}" y="${pB + 18}" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">${lbl}</text>`;
			}
			for (const vt of vertTicks) {
				const y = myLog(vt).toFixed(1);
				s += `<line x1="${pL - 5}" y1="${y}" x2="${pL}" y2="${y}" stroke="${C.axis}" stroke-width="1"/>`;
				const lbl = altOnY ? formatTick(vt, true) : tickLabelFor(v, vt);
				s += `<text x="${pL - 8}" y="${(myLog(vt) + 4).toFixed(1)}" text-anchor="end" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">${lbl}</text>`;
			}

			s += `<text x="${(pL + pW / 2).toFixed(1)}" y="${HS - 10}" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="${C.text}">${xLabel}</text>`;
			s += `<text transform="rotate(-90)" x="${-(pT + pH / 2).toFixed(1)}" y="15" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="${C.text}">${yLabel}</text>`;

			let d = '';
			let started = false;
			for (const p of pts) {
				if (p.y === null || p.y <= 0) { started = false; continue; }
				const svgX = altOnY ? mxLog(p.y) : mxLog(p.x);
				const svgY = altOnY ? myLog(p.x) : myLog(p.y);
				d += started ? ` L${svgX.toFixed(2)},${svgY.toFixed(2)}` : `M${svgX.toFixed(2)},${svgY.toFixed(2)}`;
				started = true;
			}
			if (d) s += `<path d="${d}" fill="none" stroke="${C.line}" stroke-width="2" clip-path="url(#c)"/>`;
			svgEl.innerHTML = s;
			return;
		}

		// ── Linear scale ───────────────────────────────────────────────────────
		const autoYMin = (v.key !== 'temperature' && v.key !== 'boiling_point' && yDataMin >= 0 && yDataMax > yDataMin * 2) ? 0 : yDataMin;
		yLo = yMinUser !== null ? yMinUser : autoYMin;
		yHi = yMaxUser !== null ? yMaxUser : yDataMax;
		if (yLo >= yHi) { svgEl.innerHTML = ''; return; }

		yTicks = linearTicks(yLo, yHi, yIntervals);
		const xTicks = linearTicks(xMin, xMax, xIntervals);

		const pL = 62, pR = W - 20, pT = 35, pB = HS - 50;
		const pW = pR - pL, pH = pB - pT;

		// When altOnY: altitude on vertical axis, variable on horizontal axis
		const horzLo = altOnY ? yLo  : xMin;
		const horzHi = altOnY ? yHi  : xMax;
		const vertLo = altOnY ? xMin : yLo;
		const vertHi = altOnY ? xMax : yHi;
		const horzTicks = altOnY ? yTicks  : xTicks;
		const vertTicks = altOnY ? xTicks  : yTicks;

		const mx = (val: number) => pL + (val - horzLo) / (horzHi - horzLo) * pW;
		my = (val: number) => pB - (val - vertLo) / (vertHi - vertLo) * pH;

		const altLabel = `${xVar === 'geometric' ? 'Geometric' : 'Geopotential'} altitude (${xUnit})`;
		const xLabel = altOnY ? v.label : altLabel;
		const yLabel = altOnY ? altLabel : v.label;

		let s = '';
		s += `<rect width="${W}" height="${HS}" fill="${C.bg}"/>`;
		s += `<rect x="${pL}" y="${pT}" width="${pW}" height="${pH}" fill="${C.plotBg}"/>`;
		s += `<defs><clipPath id="c"><rect x="${pL}" y="${pT}" width="${pW}" height="${pH}"/></clipPath></defs>`;

		// Grid lines
		for (const ht of horzTicks) {
			const x = mx(ht).toFixed(1);
			s += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pB}" stroke="${C.grid}" stroke-width="1"/>`;
		}
		for (const vt of vertTicks) {
			const y = my(vt).toFixed(1);
			s += `<line x1="${pL}" y1="${y}" x2="${pR}" y2="${y}" stroke="${C.grid}" stroke-width="1"/>`;
		}

		// Axes
		s += `<line x1="${pL}" y1="${pT}" x2="${pL}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;
		s += `<line x1="${pL}" y1="${pB}" x2="${pR}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;

		// Horizontal ticks and labels
		for (const ht of horzTicks) {
			const x = mx(ht).toFixed(1);
			s += `<line x1="${x}" y1="${pB}" x2="${x}" y2="${pB + 5}" stroke="${C.axis}" stroke-width="1"/>`;
			const lbl = altOnY ? tickLabelFor(v, ht) : formatTick(ht, true);
			s += `<text x="${x}" y="${pB + 18}" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">${lbl}</text>`;
		}

		// Vertical ticks and labels
		for (const vt of vertTicks) {
			const y = my(vt).toFixed(1);
			s += `<line x1="${pL - 5}" y1="${y}" x2="${pL}" y2="${y}" stroke="${C.axis}" stroke-width="1"/>`;
			const lbl = altOnY ? formatTick(vt, true) : tickLabelFor(v, vt);
			s += `<text x="${pL - 8}" y="${(my(vt) + 4).toFixed(1)}" text-anchor="end" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">${lbl}</text>`;
		}

		// Axis labels
		s += `<text x="${(pL + pW / 2).toFixed(1)}" y="${HS - 10}" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="${C.text}">${xLabel}</text>`;
		s += `<text transform="rotate(-90)" x="${-(pT + pH / 2).toFixed(1)}" y="15" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="${C.text}">${yLabel}</text>`;

		// Data line
		let d = '';
		let started = false;
		for (const p of pts) {
			if (p.y === null) { started = false; continue; }
			const svgX = altOnY ? mx(p.y) : mx(p.x);
			const svgY = altOnY ? my(p.x) : my(p.y);
			d += started ? ` L${svgX.toFixed(2)},${svgY.toFixed(2)}` : `M${svgX.toFixed(2)},${svgY.toFixed(2)}`;
			started = true;
		}
		if (d) s += `<path d="${d}" fill="none" stroke="${C.line}" stroke-width="2" clip-path="url(#c)"/>`;

		svgEl.innerHTML = s;
	}

	// ── Multi-variable render: altitude always vertical (shared real axis); each
	// variable gets its own auto-scaled horizontal axis, stacked below the plot with
	// its name to the right of its tick numbers, plus a color-keyed legend underneath. ──
	function renderMulti(
		svgEl: SVGSVGElement, C: ReturnType<typeof graphColors>, vars: VarConfig[],
		xVals: number[], series: (number | null)[][],
		opts: { xVar: string; xUnit: string; xMin: number; xMax: number; xIntervals: number; yIntervals: number },
	) {
		const { xVar, xUnit, xMin, xMax, xIntervals, yIntervals } = opts;
		const N = vars.length;

		// Reserve enough right-margin width for the last tick's number (which can be as
		// wide as scientific notation, e.g. "5.333e+24") plus a "[N]" marker referencing
		// the legend below, so nothing overflows past the viewBox or collides with the plot.
		const tickGap = 34;
		const labelSpace = 70;

		const W = 600;
		const pL = 62, pR = W - labelSpace, pT = 35;
		const plotH = 260;
		const pB = pT + plotH;
		const pW = pR - pL;
		const axisRowH = 20;
		const axisRowsStart = pB + 4;
		const legendGap = 14;
		const legendRowH = 16;
		const legendStart = axisRowsStart + N * axisRowH + legendGap;
		const HS = legendStart + N * legendRowH + 12;

		svgEl.setAttribute('viewBox', `0 0 ${W} ${HS}`);

		// Per-series axis: each variable's own range (its own min/max fields, else auto
		// from data) and its own scale (log only if that variable's checkbox is on and the
		// resulting range is strictly positive — falls back to linear otherwise). Every
		// axis gets the same tick COUNT (yIntervals); only the tick values differ.
		interface AxisInfo { lo: number; hi: number; ticks: number[]; map: (val: number) => number; isLog: boolean }
		const axes: (AxisInfo | null)[] = vars.map((v, vi) => {
			const valid = series[vi].filter((y): y is number => y !== null);
			if (valid.length < 2) return null;
			const dataLo = Math.min(...valid), dataHi = Math.max(...valid);

			if (v.logScale) {
				let lo = v.yMin !== null && v.yMin > 0 ? v.yMin : dataLo;
				let hi = v.yMax !== null && v.yMax > 0 ? v.yMax : dataHi;
				if (lo <= 0 || hi <= 0 || lo >= hi) { lo = dataLo; hi = dataHi; }
				if (lo > 0 && hi > lo) {
					const ticks = logTicks(lo, hi, yIntervals);
					const logLo = Math.log10(lo), logHi = Math.log10(hi);
					const map = (val: number) => val > 0 ? pL + (Math.log10(val) - logLo) / (logHi - logLo) * pW : pL;
					return { lo, hi, ticks, map, isLog: true };
				}
				// Data/range isn't strictly positive — fall through to a linear axis.
			}

			let lo = v.yMin !== null ? v.yMin : dataLo;
			let hi = v.yMax !== null ? v.yMax : dataHi;
			if (lo >= hi) { lo = dataLo; hi = dataHi; }
			if (lo === hi) {
				const pad = lo !== 0 ? Math.abs(lo) * 0.1 : 1;
				lo -= pad; hi += pad;
			} else if (v.yMin === null && v.key !== 'temperature' && v.key !== 'boiling_point' && lo >= 0 && hi > lo * 2) {
				lo = 0;
			}
			const ticks = linearTicks(lo, hi, yIntervals);
			const map = (val: number) => pL + (val - lo) / (hi - lo) * pW;
			return { lo, hi, ticks, map, isLog: false };
		});
		if (axes.every(a => a === null)) { svgEl.innerHTML = ''; return; }

		const xTicks = linearTicks(xMin, xMax, xIntervals);
		const myAlt = (val: number) => pB - (val - xMin) / (xMax - xMin) * plotH;

		let s = '';
		s += `<rect width="${W}" height="${HS}" fill="${C.bg}"/>`;
		s += `<rect x="${pL}" y="${pT}" width="${pW}" height="${plotH}" fill="${C.plotBg}"/>`;
		s += `<defs><clipPath id="c"><rect x="${pL}" y="${pT}" width="${pW}" height="${plotH}"/></clipPath></defs>`;

		// Shared altitude gridlines (horizontal)
		for (const xt of xTicks) {
			const y = myAlt(xt).toFixed(1);
			s += `<line x1="${pL}" y1="${y}" x2="${pR}" y2="${y}" stroke="${C.grid}" stroke-width="1"/>`;
		}
		// Per-variable gridlines (vertical) — every axis contributes its own ticks, all
		// drawn in the same neutral grid color so they read as gridlines, not data.
		for (const a of axes) {
			if (!a) continue;
			for (const t of a.ticks) {
				const x = a.map(t).toFixed(1);
				s += `<line x1="${x}" y1="${pT}" x2="${x}" y2="${pB}" stroke="${C.grid}" stroke-width="1"/>`;
			}
		}

		// Plot border
		s += `<line x1="${pL}" y1="${pT}" x2="${pL}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;
		s += `<line x1="${pL}" y1="${pB}" x2="${pR}" y2="${pB}" stroke="${C.axis}" stroke-width="1.5"/>`;

		// Shared altitude axis (left)
		for (const xt of xTicks) {
			const y = myAlt(xt).toFixed(1);
			s += `<line x1="${pL - 5}" y1="${y}" x2="${pL}" y2="${y}" stroke="${C.axis}" stroke-width="1"/>`;
			s += `<text x="${pL - 8}" y="${(myAlt(xt) + 4).toFixed(1)}" text-anchor="end" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">${formatTick(xt, true)}</text>`;
		}
		const altLabel = `${xVar === 'geometric' ? 'Geometric' : 'Geopotential'} altitude (${xUnit})`;
		s += `<text transform="rotate(-90)" x="${-(pT + plotH / 2).toFixed(1)}" y="15" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="${C.text}">${altLabel}</text>`;

		// One line per variable, each on its own horizontal scale
		vars.forEach((v, vi) => {
			const a = axes[vi];
			if (!a) return;
			const color = LINE_COLORS[vi % LINE_COLORS.length];
			let d = '';
			let started = false;
			for (let i = 0; i < xVals.length; i++) {
				const yVal = series[vi][i];
				if (yVal === null || (a.isLog && yVal <= 0)) { started = false; continue; }
				const svgX = a.map(yVal);
				const svgY = myAlt(xVals[i]);
				d += started ? ` L${svgX.toFixed(2)},${svgY.toFixed(2)}` : `M${svgX.toFixed(2)},${svgY.toFixed(2)}`;
				started = true;
			}
			if (d) s += `<path d="${d}" fill="none" stroke="${color}" stroke-width="2" clip-path="url(#c)"/>`;
		});

		// Per-variable axis rows: tick numbers with a "[N]" marker to their right,
		// referencing that variable's full name/unit in the legend below.
		vars.forEach((v, vi) => {
			const a = axes[vi];
			if (!a) return;
			const color = LINE_COLORS[vi % LINE_COLORS.length];
			const rowY = axisRowsStart + vi * axisRowH + 12;
			for (const t of a.ticks) {
				const x = a.map(t).toFixed(1);
				s += `<text x="${x}" y="${rowY}" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="${color}">${tickLabelFor(v, t)}</text>`;
			}
			s += `<text x="${pR + tickGap}" y="${rowY}" text-anchor="start" font-family="Arial,sans-serif" font-size="11" fill="${color}">[${vi + 1}]</text>`;
		});

		// Legend
		vars.forEach((v, vi) => {
			const a = axes[vi];
			if (!a) return;
			const color = LINE_COLORS[vi % LINE_COLORS.length];
			const rowY = legendStart + vi * legendRowH + 9;
			s += `<rect x="${pL}" y="${(rowY - 9).toFixed(1)}" width="10" height="10" fill="${color}"/>`;
			s += `<text x="${pL + 16}" y="${rowY}" text-anchor="start" font-family="Arial,sans-serif" font-size="11" fill="${C.text}">[${vi + 1}] ${v.label}</text>`;
		});

		svgEl.innerHTML = s;
	}

	// Initial population and render
	updateModeUI();
	generateGraph();

	// Re-render graph when dark mode is toggled
	document.getElementById('theme-toggle')
		?.addEventListener('click', () => setTimeout(generateGraph, 0));

	(document.getElementById('x-unit') as HTMLSelectElement).addEventListener('change', generateGraph);

	function updateConditionLabels() {
		const tMode = (document.getElementById('temp-mode') as HTMLSelectElement).value;
		(document.getElementById('lbl-sl-temp') as HTMLElement).textContent =
			tMode === 'air' ? 'Air temperature' : 'Sea-level temperature';
		const pMode = (document.getElementById('pressure-mode') as HTMLSelectElement).value;
		(document.getElementById('lbl-sl-pressure') as HTMLElement).textContent =
			pMode === 'air' ? 'Air pressure' : pMode === 'altimeter' ? 'Altimeter setting' : 'Sea-level pressure';
	}

	document.getElementById('temp-mode')!.addEventListener('change', () => { updateConditionLabels(); generateGraph(); });
	document.getElementById('pressure-mode')!.addEventListener('change', () => { updateConditionLabels(); generateGraph(); });
	updateConditionLabels();

	// All other inputs
	for (const id of ['cond-alt', 'cond-alt-unit', 'sl-temp', 'sl-temp-unit', 'sl-pressure', 'sl-pressure-unit', 'x-var', 'x-min', 'x-max', 'x-intervals', 'alt-on-y', 'y-intervals']) {
		const el = document.getElementById(id)!;
		el.addEventListener('input', generateGraph);
		el.addEventListener('change', generateGraph);
	}

	// Dependent-variable checklist: enforce the max selection count, keep the
	// value-axis controls' enabled state in sync with single vs. multi mode, and redraw.
	document.getElementById('var-list')!.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		const errVarCount = document.getElementById('err-var-count') as HTMLElement;
		// Only the variable/species checkboxes (data-var) count toward the cap — the
		// per-variable log checkboxes are plain <input type=checkbox> with no data-var.
		if (target?.type === 'checkbox' && target.dataset.var !== undefined) {
			const checkedCount = document.querySelectorAll('#var-list input[type=checkbox][data-var]:checked').length;
			if (checkedCount > MAX_VARS) {
				target.checked = false;
				errVarCount.textContent = `You can select up to ${MAX_VARS} variables at once.`;
				return;
			}
			errVarCount.textContent = '';
		}
		updateModeUI();
		generateGraph();
	});
	// The per-variable min/max fields also want live updates while typing, not just on blur.
	document.getElementById('var-list')!.addEventListener('input', (e) => {
		const target = e.target as HTMLInputElement;
		if (target?.type === 'number') { updateModeUI(); generateGraph(); }
	});

	// Reset to standard conditions
	document.getElementById('btn-reset')!.addEventListener('click', () => {
		const altUnit  = (document.getElementById('cond-alt-unit') as HTMLSelectElement).value;
		const tempUnit = (document.getElementById('sl-temp-unit') as HTMLSelectElement).value;
		const pressUnit = (document.getElementById('sl-pressure-unit') as HTMLSelectElement).value;
		(document.getElementById('cond-alt') as HTMLInputElement).value =
			roundSig(convert(0, 'm', altUnit), 6, 1e-6, true);
		(document.getElementById('sl-temp') as HTMLInputElement).value =
			roundSig(convert(288.15, 'K', tempUnit), 6, 1e-6, true);
		(document.getElementById('sl-pressure') as HTMLInputElement).value =
			roundSig(convert(101325, 'Pa', pressUnit), 6, 1e-6, true);
		(document.getElementById('temp-mode') as HTMLSelectElement).value = 'sea-level';
		(document.getElementById('pressure-mode') as HTMLSelectElement).value = 'sea-level';
		updateConditionLabels();
		generateGraph();
	});

	// Download
	document.getElementById('btn-download')!.addEventListener('click', () => {
		const svg = document.getElementById('graph-svg') as unknown as SVGGraphicsElement;
		const str = '<?xml version="1.0" encoding="UTF-8"?>\n' + new XMLSerializer().serializeToString(svg);
		const url = URL.createObjectURL(new Blob([str], { type: 'image/svg+xml' }));
		const a = Object.assign(document.createElement('a'), { href: url, download: 'atmosphere-graph.svg' });
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});
</script>
