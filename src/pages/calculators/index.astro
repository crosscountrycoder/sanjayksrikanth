---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CalculatorsList from '../../components/CalculatorsList.astro';
---

<Layout>
	<Breadcrumb crumbs={[
		{ label: 'Home', href: '/' },
		{ label: 'Calculators' },
	]} />
	<h1>Calculators</h1>
	<section>
		<CalculatorsList />
	</section>
</Layout>

<style>
	ul {
		list-style: disc;
		padding-left: 1.5rem;
	}
</style>
